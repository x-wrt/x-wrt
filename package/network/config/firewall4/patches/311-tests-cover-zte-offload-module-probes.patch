diff --git a/tests/01_configuration/13_zte_natflow b/tests/01_configuration/13_zte_natflow
new file mode 100644
index 0000000..3ebebd1
--- /dev/null
+++ b/tests/01_configuration/13_zte_natflow
@@ -0,0 +1,30 @@
+SR1010 natflow handles forwarding even when both nft offload options are enabled.
+
+-- Testcase --
+{%
+	fw4.load(false);
+	print(fw4.resolve_offload_devices(), "\n");
+	print([ fw4.default_option("flow_offloading"), fw4.default_option("flow_offloading_hw") ], "\n");
+%}
+-- End --
+
+-- File uci/firewall.json --
+{ "defaults": [ { "flow_offloading": 1, "flow_offloading_hw": 1 } ] }
+-- End --
+
+-- File uci/helpers.json --
+{}
+-- End --
+
+-- File fs/stat~_sys_module_natflow.json --
+{ "type": "directory" }
+-- End --
+
+-- File fs/open~_tmp_sysinfo_board_name.txt --
+zte,zx279133-sr1010
+-- End --
+
+-- Expect stdout --
+[ ]
+[ false, false ]
+-- End --
