+static bool shared_overlay_rescue(const char *dir)
+{
+	char cmd[160];
+
+	snprintf(cmd, sizeof(cmd), "/usr/libexec/zte-overlay-rescue %s", dir);
+	if (system(cmd)) {
+		ULOG_ERR("could not reset the shared overlay\n");
+		return false;
+	}
+	return true;
+}
+
+static bool shared_overlay_recover_pending(const char *dir)
+{
+	static const char *const names[] = { "sysupgrade.tgz.tmp", ".sysupgrade.pending" };
+	char path[96];
+	struct stat st;
+	size_t i;
+
+	for (i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		snprintf(path, sizeof(path), "%s/%s", dir, names[i]);
+		if (!lstat(path, &st))
+			return S_ISREG(st.st_mode) && shared_overlay_rescue(dir);
+		if (errno != ENOENT)
+			return false;
+	}
+	return true;
+}
