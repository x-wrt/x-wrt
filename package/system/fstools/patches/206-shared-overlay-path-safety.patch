+static bool shared_overlay_paths_valid(const char *path)
+{
+	static const char *const trees[] = { "upper", "work" };
+	struct stat st;
+	size_t i;
+	int fd, err = 0;
+
+	fd = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0)
+		return errno == ENOENT;
+	for (i = 0; i < sizeof(trees) / sizeof(trees[0]); i++) {
+		if (fstatat(fd, trees[i], &st, AT_SYMLINK_NOFOLLOW)) {
+			if (errno == ENOENT)
+				continue;
+			err = errno;
+		} else if (!S_ISDIR(st.st_mode)) {
+			err = ENOTDIR;
+		}
+		if (err)
+			break;
+	}
+	close(fd);
+	if (!err)
+		return true;
+	errno = err;
+	return false;
+}
+
 /**
  * fs_overlay_path - where the overlay state and trees are under @mp
  *
@@ -154,10 +183,16 @@ bool fs_shared_overlay(void)
  */
 const char *fs_overlay_path(const char *mp, char *buf, size_t len)
 {
-	if (fs_shared_overlay() && mp[0])
-		snprintf(buf, len, "%s/.owrt", mp);
-	else
-		snprintf(buf, len, "%s", mp);
+	bool shared = fs_shared_overlay() && mp[0];
+	int n;
+
+	n = snprintf(buf, len, shared ? "%s/.owrt" : "%s", mp);
+	if (n < 0 || (size_t)n >= len) {
+		errno = ENAMETOOLONG;
+		return NULL;
+	}
+	if (shared && !shared_overlay_paths_valid(buf))
+		return NULL;
 	return buf;
 }
 
@@ -166,10 +201,15 @@ const char *fs_overlay_path(const char *mp, char *buf, size_t len)
  */
 const char *fs_overlay_dir(const char *mp, char *buf, size_t len)
 {
-	fs_overlay_path(mp, buf, len);
-	if (fs_shared_overlay())
-		mkdir(buf, 0755);
-	return buf;
+	if (!fs_overlay_path(mp, buf, len))
+		return NULL;
+	if (!fs_shared_overlay() || !mp[0])
+		return buf;
+	if (!mkdir(buf, 0755))
+		return buf;
+	if (errno != EEXIST)
+		return NULL;
+	return fs_overlay_path(mp, buf, len);
 }
 
