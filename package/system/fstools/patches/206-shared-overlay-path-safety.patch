@@ -576,7 +600,10 @@ int mount_overlay(struct volume *v)
 	}
 
 	/* The state and upper/work trees live here (a sub-directory if shared). */
-	fs_overlay_dir(overlay_mp, ovl_data, sizeof(ovl_data));
+	if (!fs_overlay_dir(overlay_mp, ovl_data, sizeof(ovl_data)))
+		goto invalid_overlay;
+	if (fs_shared_overlay() && !shared_overlay_recover_pending(ovl_data))
+		goto invalid_overlay;
 
 	/*
 	 * Check for extroot config in overlay (rootfs_data) and if present then
@@ -588,8 +615,11 @@ int mount_overlay(struct volume *v)
 	}
 
 	/* Settings only: drop an overlay that belongs to another root filesystem. */
-	if (fs_shared_overlay() && !read_rom_id(rom_id))
-		record = shared_rom_check(ovl_data, rom_id);
+	if (fs_shared_overlay() && !read_rom_id(rom_id)) {
+		if (!shared_rom_check(ovl_data, rom_id))
+			goto invalid_overlay;
+		record = true;
+	}
 
 	switch (fs_state_get(ovl_data)) {
 	case FS_STATE_UNKNOWN:
@@ -617,5 +647,12 @@ int mount_overlay(struct volume *v)
 		return ramoverlay();
 	}
 
+	return -1;
+invalid_overlay:
+	umount(overlay_mp);
+	if (fs_shared_overlay()) {
