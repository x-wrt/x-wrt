#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=17
STOP=82
USE_PROCD=1

CAPTURE_DIR="/tmp/airoha-pon-debug/capture"
DEBUG_ENABLED=0
PPPOE_FILTER='ether[12:2] = 0x8863 or ether[12:2] = 0x8864 or ((ether[12:2] = 0x8100 or ether[12:2] = 0x88a8) and (ether[16:2] = 0x8863 or ether[16:2] = 0x8864)) or ((ether[12:2] = 0x8100 or ether[12:2] = 0x88a8) and (ether[16:2] = 0x8100 or ether[16:2] = 0x88a8) and (ether[20:2] = 0x8863 or ether[20:2] = 0x8864))'

load_debug_setting() {
	config_load airoha-pon-debug
	config_get_bool DEBUG_ENABLED capture enabled 0
}

trim_old_captures() {
	local limit_kb="$1"
	local oldest size_kb

	while true; do
		size_kb="$(du -sk "$CAPTURE_DIR" 2>/dev/null | awk '{ print $1 }')"
		[ "${size_kb:-0}" -le "$limit_kb" ] && break
		oldest="$(ls -1tr "$CAPTURE_DIR"/*.pcap* 2>/dev/null | head -n 1)"
		[ -n "$oldest" ] || break
		rm -f "$oldest"
	done
}

safe_name() {
	printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

line_uses_epon() {
	local line="$1"
	local mode

	config_get mode "$line" mode
	case "$mode" in
	epon-*) return 0 ;;
	*) return 1 ;;
	esac
}

start_capture() {
	local instance="$1"
	local device="$2"
	local output="$3"
	local size_mb="$4"
	local files="$5"
	shift 5

	[ -n "$device" ] || return 0
	[ -e "/sys/class/net/$device" ] || {
		logger -t airoha-pon-debug "capture interface $device is unavailable"
		return 0
	}

	# The helper waits for administrative up; procd respawn would add 5 s.
	procd_open_instance "$(safe_name "$instance")"
	procd_set_param command /usr/libexec/airoha-pon-debug capture \
		"$device" "$output" "$size_mb" "$files" "$@"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

start_line_capture() {
	local section="$1"
	local device name

	config_get device "$section" device
	name="$(safe_name "$section")"
	# Separate data-plane and PPPoE rings preserve traffic context and discovery timing.
	start_capture "line-$name" "$device" "line-$name" 2 3
	start_capture "pppoe-$name" "$device" "pppoe-$name" 1 2 \
		"$PPPOE_FILTER"
	procd_open_instance "state-$name"
	procd_set_param command /usr/libexec/airoha-pon-debug sample "$name" "$device"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

start_omci_capture() {
	local section="$1"
	local line device name

	config_get line "$section" line
	line_uses_epon "$line" && return 0
	config_get device "$section" device
	name="$(safe_name "$section")"
	start_capture "omci-$name" "$device" "omci-$name" 1 3
}

start_oam_capture() {
	local section="$1"
	local line device name

	config_get line "$section" line
	line_uses_epon "$line" || return 0
	config_get device "$section" device
	name="$(safe_name "$section")"
	start_capture "oam-$name" "$device" "oam-$name" 1 1
}

start_service() {
	load_debug_setting
	[ "$DEBUG_ENABLED" -eq 1 ] || return 0

	mkdir -p "$CAPTURE_DIR"
	chmod 0700 "$(dirname "$CAPTURE_DIR")" "$CAPTURE_DIR"
	trim_old_captures 4096

	config_load pon
	config_foreach start_line_capture xpon
	config_foreach start_omci_capture omci
	config_foreach start_oam_capture oam
}

reload_service() {
	stop
	start
	load_debug_setting
	[ "$DEBUG_ENABLED" -eq 1 ] || return 0

	# Restarting after capture begins records early PHY and management exchanges.
	/usr/libexec/airoha-pon-debug restart >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger airoha-pon-debug
}
