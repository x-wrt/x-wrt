#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

# Each xpon section owns one userspace protocol agent instance.
# The configured line mode selects the OMCI or OAM control netdev.

START=19
STOP=81
USE_PROCD=1

CONTROL_DEVICE=

find_control_device() {
	local section="$1"
	local expected_line="$2"
	local linked_line

	config_get linked_line "$section" line
	[ "$linked_line" = "$expected_line" ] || return 0
	config_get CONTROL_DEVICE "$section" device
}

start_line_instance() {
	local line="$1"
	local mode protocol

	config_get mode "$line" mode
	case "$mode" in
	epon-*) protocol=oam ;;
	*) protocol=omci ;;
	esac

	CONTROL_DEVICE=
	config_foreach find_control_device "$protocol" "$line"
	[ -n "$CONTROL_DEVICE" ] || {
		echo "$protocol control device for line '$line' is missing" >&2
		return 1
	}
	ip link set "$CONTROL_DEVICE" up || return 1

	procd_open_instance "$line"
	procd_set_param command /usr/sbin/airoha-pond --line "$line"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/pon
	procd_close_instance
}

stop_control_device() {
	local section="$1"
	local device

	config_get device "$section" device
	[ -z "$device" ] || ip link set "$device" down 2>/dev/null
}

start_service() {
	config_load pon
	config_foreach start_line_instance xpon
}

stop_service() {
	config_load pon
	config_foreach stop_control_device omci
	config_foreach stop_control_device oam
	rm -f /var/run/airoha-pond.*.sock
}
