#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0

START=19
USE_PROCD=1

start_service() {
	# Boot ordering lets network and firewall consume the generated configuration.
	/usr/libexec/iptv-apply boot
}

reload_service() {
	/usr/libexec/iptv-apply reload
}

service_triggers() {
	procd_add_reload_trigger "iptv"
}
