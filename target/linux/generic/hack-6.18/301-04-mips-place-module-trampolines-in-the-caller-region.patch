+/* The loader lays out executable sections before other sections. */
+unsigned int arch_mod_section_prepend(struct module *mod, unsigned int section)
+{
+	unsigned int k;
+
+	for (k = 0; k < MIPS_PLT_AREAS; k++)
+		if (mod->arch.plt_entries[k] && mod->arch.plt_shndx[k] == section)
+			return mod->arch.plt_entries[k] * MIPS_PLT_ENTRY_SIZE;
+	return 0;
+}
