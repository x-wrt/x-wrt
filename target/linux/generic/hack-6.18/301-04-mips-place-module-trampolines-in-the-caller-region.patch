+/*
+ * Reserve one entry per distinct symbol and addend that may need a PLT.
+ * Targets within the same text allocation are reachable directly.
+ */
+static int mips_count_plt_entries(const Elf_Ehdr *hdr, const Elf_Shdr *sechdrs,
+				  const char *secstrings, unsigned int symindex,
+				  bool init, unsigned int *entries)
+{
+	const Elf_Sym *syms = (void *)sechdrs[symindex].sh_addr;
+	unsigned int i, j, n = 0, max = 0, unique = 0;
+	u64 *keys;
+
+	*entries = 0;
+	for (i = 1; i < hdr->e_shnum; i++) {
+		const Elf_Shdr *rs = &sechdrs[i];
+		bool rela = rs->sh_type == SHT_RELA;
+		unsigned int count;
 
-		/* If it's called *.init*, and we're not init, we're
-                   not interested */
