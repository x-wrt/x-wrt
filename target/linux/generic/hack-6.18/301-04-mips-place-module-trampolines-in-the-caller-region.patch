 /*
- * Get the potential max trampolines size required of the init and
- * non-init sections. Only used if we cannot find enough contiguous
- * physically mapped memory to put the module into.
+ * J and JAL can only reach targets in the same 256 MiB region as their
+ * delay slot. Reserve trampolines inside each module text allocation so
+ * they are reachable and included in the module instruction cache flush.
  */
-static unsigned int
-get_plt_size(const Elf_Ehdr *hdr, const Elf_Shdr *sechdrs,
-             const char *secstrings, unsigned int symindex, bool is_init)
+#define MIPS_PLT_ENTRY_WORDS	4
+#define MIPS_PLT_ENTRY_SIZE	(MIPS_PLT_ENTRY_WORDS * sizeof(u32))
+
+#define MIPS_JUMP_FIELD		GENMASK(25, 0)
+#define MIPS_JUMP_REGION_MASK	(~(SZ_256M - 1UL))
+
+enum { MIPS_PLT_CORE, MIPS_PLT_INIT, MIPS_PLT_AREAS };
+
+struct mips_plt_area {
+	u32 *slots;
+	unsigned int entries;
