-		/* Don't bother with non-allocated sections */
-		if (!(sechdrs[info].sh_flags & SHF_ALLOC))
-			continue;
+/* The REL addend is a word-scaled offset, signed for external symbols. */
+static long mips_r26_rel_addend(u32 insn, const Elf_Sym *sym)
+{
+	u32 offset = (insn & MIPS_JUMP_FIELD) << 2;
+
+	if (ELF_ST_BIND(sym->st_info) == STB_LOCAL)
+		return offset;
+	return sign_extend32(offset, 27);
+}
+
+static const Elf_Shdr *mips_plt_reloc_target(const Elf_Ehdr *hdr,
+					     const Elf_Shdr *sechdrs,
+					     const char *secstrings,
+					     const Elf_Shdr *rs, bool init)
+{
+	const Elf_Shdr *ts;
+
+	if ((rs->sh_type != SHT_REL && rs->sh_type != SHT_RELA) ||
+	    rs->sh_info >= hdr->e_shnum)
+		return NULL;
+	ts = &sechdrs[rs->sh_info];
+	if (!mips_exec_section(ts) || mips_init_section(secstrings, ts) != init)
+		return NULL;
+	return ts;
+}
