 			continue;
+		count = rs->sh_size / (rela ? sizeof(Elf_Mips_Rela) : sizeof(Elf_Mips_Rel));
+		for (j = 0; j < count; j++) {
+			const Elf_Mips_Rel *rel = (void *)rs->sh_addr + j * sizeof(*rel);
+			const Elf_Mips_Rela *ra = (void *)rs->sh_addr + j * sizeof(*ra);
 
-		syms = (Elf_Sym *) sechdrs[symindex].sh_addr;
-		if (sechdrs[i].sh_type == SHT_REL) {
-			Elf_Mips_Rel *rel = (void *) sechdrs[i].sh_addr;
-			unsigned int size = sechdrs[i].sh_size / sizeof(*rel);
+			if ((rela ? ELF_MIPS_R_TYPE(*ra) : ELF_MIPS_R_TYPE(*rel)) == R_MIPS_26)
+				max++;
+		}
+	}
+	if (!max)
+		return 0;
 
-			for (j = 0; j < size; ++j) {
-				Elf_Sym *sym;
+	keys = kvmalloc_array(max, sizeof(*keys), GFP_KERNEL);
+	if (!keys)
+		return -ENOMEM;
 
-				if (ELF_MIPS_R_TYPE(rel[j]) != R_MIPS_26)
-					continue;
+	for (i = 1; i < hdr->e_shnum; i++) {
+		const Elf_Shdr *rs = &sechdrs[i];
+		const Elf_Shdr *ts = mips_plt_reloc_target(hdr, sechdrs, secstrings, rs, init);
+		bool rela = rs->sh_type == SHT_RELA;
+		unsigned int count;
 
-				sym = syms + ELF_MIPS_R_SYM(rel[j]);
-				if (!is_init && sym->st_shndx != SHN_UNDEF)
-					continue;
+		if (!ts)
+			continue;
 
-				ret += 4 * sizeof(int);
-			}
-		} else {
-			Elf_Mips_Rela *rela = (void *) sechdrs[i].sh_addr;
-			unsigned int size = sechdrs[i].sh_size / sizeof(*rela);
+		count = rs->sh_size / (rela ? sizeof(Elf_Mips_Rela) : sizeof(Elf_Mips_Rel));
+		for (j = 0; j < count; j++) {
+			const Elf_Mips_Rel *rel = (void *)rs->sh_addr + j * sizeof(*rel);
+			const Elf_Mips_Rela *ra = (void *)rs->sh_addr + j * sizeof(*ra);
+			const Elf_Sym *sym;
+			u32 addend;
 
-			for (j = 0; j < size; ++j) {
-				Elf_Sym *sym;
+			if ((rela ? ELF_MIPS_R_TYPE(*ra) : ELF_MIPS_R_TYPE(*rel)) != R_MIPS_26)
+				continue;
 
-				if (ELF_MIPS_R_TYPE(rela[j]) != R_MIPS_26)
-					continue;
+			sym = syms + (rela ? ELF_MIPS_R_SYM(*ra) : ELF_MIPS_R_SYM(*rel));
+			if (rela) {
+				addend = ra->r_addend;
+			} else {
+				if (ts->sh_type == SHT_NOBITS ||
+				    ts->sh_size < sizeof(u32) ||
+				    rel->r_offset > ts->sh_size - sizeof(u32)) {
+					kvfree(keys);
+					return -ENOEXEC;
+				}
+				addend = mips_r26_rel_addend(
+					get_unaligned((u32 *)(ts->sh_addr + rel->r_offset)), sym);
+			}
 
-				sym = syms + ELF_MIPS_R_SYM(rela[j]);
-				if (!is_init && sym->st_shndx != SHN_UNDEF)
-					continue;
+			if (sym->st_shndx != SHN_UNDEF && sym->st_shndx < hdr->e_shnum) {
+				const Elf_Shdr *ss = &sechdrs[sym->st_shndx];
 
-				ret += 4 * sizeof(int);
+				if (mips_exec_section(ss) &&
+				    mips_init_section(secstrings, ss) == init &&
+				    sym->st_value < ss->sh_size &&
+				    addend < ss->sh_size - sym->st_value)
+					continue;
 			}
+			if (n == max) {
+				kvfree(keys);
+				return -ENOEXEC;
+			}
+			keys[n++] = (u64)(sym - syms) << 32 | addend;
 		}
 	}
 
-	return ret;
+	sort(keys, n, sizeof(*keys), mips_cmp_plt_key, NULL);
+	for (j = 0; j < n; j++)
+		if (!j || keys[j] != keys[j - 1])
+			unique++;
+	kvfree(keys);
+
+	if (unique > SZ_256M / MIPS_PLT_ENTRY_SIZE)
+		return -ENOEXEC;
+	*entries = unique;
+	return 0;
 }
 
