/dts-v1/;

/* Firmware reserves the first 2 MiB of DRAM. */
/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "an7581.dtsi"

/*
 * UNG00A combines AN7581, an EN7572-compatible optical frontend, EN8811H,
 * and four Ethernet ports. Its wiring is defined independently from the ZN
 * board family.
 */
/ {
	model = "Unionman UNG00A";
	compatible = "unionman,ung00a", "airoha,an7581", "airoha,en7581";

	aliases {
		label-mac-device = &gdm1;
		led-boot = &led_power_green;
		led-failsafe = &led_power_green;
		led-running = &led_power_green;
		led-upgrade = &led_power_green;
		serial0 = &uart1;
	};

	chosen {
		/* fitblk locates the FIT by volume name across factory volume changes. */
		rootdisk = <&ubi_fit>;
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};

	/*
	 * The bootloader updates this node to installed DRAM before bootm.
	 * 512 MiB is the board baseline.
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			/* The reset key is connected to active-low GPIO0. */
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power_green: led-power {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			/* The active-low power LED is connected to GPIO17. */
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
			default-state = "on";
			panic-indicator;
		};

		led-pon {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			/* The active-low PON status LED is connected to GPIO18. */
			gpios = <&en7581_pinctrl 18 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-registration";
		};

		led-los {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			/* The active-low LOS LED is connected to GPIO19. */
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-los";
		};

		led-internet {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			/* The active-low Internet LED is connected to GPIO20. */
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-online";
		};

		led-phone {
			label = "green:phone";
			/* The active-low POTS hook LED is connected to GPIO24. */
			gpios = <&en7581_pinctrl 24 GPIO_ACTIVE_LOW>;
		};
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	pon_pins: pon-pins {
		mux {
			/* Leave GPIO38/TX_DISABLE under optical frontend control. */
			function = "pon";
			groups = "pon_tx_disable_gpio";
		};
	};

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};
	};

	gswp2_led0_pins: gswp2-led0-pins {
		mux {
			function = "phy2_led0";
			pins = "gpio44";
		};
	};

	gswp3_led0_pins: gswp3-led0-pins {
		mux {
			function = "phy3_led0";
			pins = "gpio45";
		};
	};
};

&snfi {
	status = "okay";
};

&spi_nand {
	/*
	 * The SPI NAND uses 2 KiB pages, 128 KiB eraseblocks, and 256 MiB capacity.
	 * The generic compatible keeps chip selection under READ ID probing.
	 */
	nand-ecc-engine = <&spi_nand>;

	partitions: partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* BootROM reads the BL2 FIP at offset 0x800 in the first eraseblock. */
		partition@0 {
			label = "bl2";
			reg = <0x00000000 0x00020000>;
			read-only;
		};

		/*
		 * UBI manages every eraseblock after BL2. The factory volume preserves
		 * per-device reservearea field offsets.
		 */
		partition@20000 {
			label = "ubi";
			reg = <0x00020000 0x00000000>;
			compatible = "linux,ubi";

			volumes {
				ubi_fip: ubi-volume-fip {
					volname = "fip";
				};

				ubi_env: ubi-volume-ubootenv {
					volname = "ubootenv";
				};

				ubi_env2: ubi-volume-ubootenv2 {
					volname = "ubootenv2";
				};

				factory: ubi-volume-factory {
					volname = "factory";

					ung00a_proline_layout: nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <1>;
						#size-cells = <1>;

						/* The production base MAC uses 12 hexadecimal ASCII characters. */
						macaddr_factory: mac-address@141021 {
							compatible = "mac-base";
							reg = <0x00141021 0x0000000c>;
							#nvmem-cell-cells = <1>;
						};

						pon_serial: pon-serial@14105a {
							reg = <0x0014105a 0x0000000c>;
						};

						/* Optical calibration retains its reservearea offset. */
						pon_calibration: calibration@1c0400 {
							reg = <0x001c0400 0x00000200>;
						};
					};
				};

				ubi_fit: ubi-volume-fit {
					volname = "fit";
				};
			};
		};
	};
};

&ubi_env {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool-layout";
	};
};

&ubi_env2 {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool-layout";
	};
};

&i2c0 {
	status = "okay";

	en7572: optical-front-end@50 {
		compatible = "airoha,en7572";
		reg = <0x50>;
		/* GPIO38 high disables upstream optical transmission. */
		tx-disable-gpios = <&en7581_pinctrl 38 GPIO_ACTIVE_HIGH>;
		nvmem-cells = <&pon_calibration>;
		nvmem-cell-names = "calibration";
	};
};

&npu {
	status = "okay";
};

&eth {
	status = "okay";
};

&gdm1 {
	/* The switch CPU port uses the production base MAC. */
	nvmem-cells = <&macaddr_factory 0>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&mdio {
	/*
	 * EN8811H uses MDIO address 0x0f and active-low GPIO31 reset.
	 * The reset sequence completes before MD32 firmware loading.
	 */
	en8811: ethernet-phy@f {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <0xf>;
		reset-gpios = <&en7581_pinctrl 31 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <20000>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led-0 {
				reg = <0>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_LAN;
				function-enumerator = <1>;
				default-state = "keep";
			};
		};
	};
};

&eth_pcs {
	/* HSGMII carries the EN8811H 2500BASE-X host link. */
	status = "okay";
};

&gdm4 {
	openwrt,netdev-name = "lan1";
	phy-handle = <&en8811>;
	phy-mode = "2500base-x";
	nvmem-cells = <&macaddr_factory 1>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&switch {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
	status = "okay";
};

/*
 * Panel LAN2, LAN3, and LAN4 map to switch ports 3, 2, and 1.
 * Their PHY addresses are 0x0b, 0x0a, and 0x09, and link state uses polling.
 */
&gsw_phy1 {
	status = "okay";
};

&gsw_port1 {
	label = "lan4";
	status = "okay";
};

&gsw_phy2 {
	interrupts = <2>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp2_led0_pins>;
	status = "okay";
};

&gsw_port2 {
	label = "lan3";
	status = "okay";
};

&gsw_phy2_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <3>;
	active-low;
	status = "okay";
};

&gsw_phy3 {
	interrupts = <3>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp3_led0_pins>;
	status = "okay";
};

&gsw_port3 {
	label = "lan2";
	status = "okay";
};

&gsw_phy3_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <2>;
	active-low;
	status = "okay";
};

&pon_pcs {
	status = "okay";
};

&xpon_mac {
	pinctrl-names = "default";
	pinctrl-0 = <&pon_pins>;
	optical-front-end = <&en7572>;
	nvmem-cells = <&pon_serial>;
	nvmem-cell-names = "pon-serial";
	data-path = <&gdm2>;
	status = "okay";
};

&gdm2 {
	nvmem-cells = <&macaddr_factory 0>;
	nvmem-cell-names = "mac-address";
	airoha,pon-data-path;
	status = "okay";
};
