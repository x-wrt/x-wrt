From: X-WRT <dev@x-wrt.com>
Date: Fri, 25 Sep 2026 02:45:00 +0800
Subject: [PATCH] net: airoha: add AN7563 Ethernet support

Add the AN7563 FE/QDMA layout and vendor-aligned PON active-Ethernet
initialization to the unified Airoha driver. AN7563 has two GDMs,
eight TX rings, sixteen RX rings and two QDMA interrupt registers.

Use GDMP-backed PSE SRAM, DRAM LMGR descriptors, 1 KiB forwarding
buffers, QDMA1 channel zero, disabled accounting groups and the vendor
WAN QoS settings. Route fragment and reassembly traffic through the
AN7563 NPU and RX queues.

Preserve the DSA destination channel while folding logical queues onto
the eight physical TX rings, and keep AN7563's zero-based priority
mapping. Pad short WAN packets to the vendor 64-byte minimum.

Keep normal 2 KiB RX frames linear. Enable scatter only when an active
netdev sharing the QDMA uses an MTU above 2026, retaining jumbo-frame
support without changing the standard-MTU receive path.

Signed-off-by: X-WRT <dev@x-wrt.com>
---
diff --git a/drivers/net/ethernet/airoha/Kconfig b/drivers/net/ethernet/airoha/Kconfig
index 66a7ddfed7f..74e27d1e25b 100644
--- a/drivers/net/ethernet/airoha/Kconfig
+++ b/drivers/net/ethernet/airoha/Kconfig
@@ -22,6 +22,7 @@ config NET_AIROHA_NPU
 config NET_AIROHA
 	tristate "Airoha/EcoNet frame-engine Ethernet support"
 	depends on OF
+	select MFD_SYSCON
 	select PHYLINK
 	select PAGE_POOL
 	imply NET_AIROHA_NPU if ARCH_AIROHA
diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 8e318e8069a..655e0b6196a 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -22,6 +22,7 @@
 #include <linux/ioport.h>
 #include <linux/ipv6.h>
 #include <linux/mdio.h>
+#include <linux/mfd/syscon.h>
 #include <linux/mm.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
@@ -35,6 +36,7 @@
 #include <linux/printk.h>
 #include <linux/ratelimit.h>
 #include <linux/rcupdate.h>
+#include <linux/regmap.h>
 #include <linux/reset.h>
 #include <linux/rtnetlink.h>
 #include <linux/seq_file.h>
@@ -64,6 +66,10 @@ static void econet_prepare_qdma_cfg(struct airoha_qdma_mips_cfg *cfg,
 				    const struct airoha_eth_soc_data *soc,
 				    int id);
 
+#define AN7563_SCU_SSR3			0x94
+#define AN7563_SCU_SSR3_GDMP_CLK_SEL	BIT(30)
+#define AN7563_PSE_SHARE_USED_THD	0x01e001f4
+
 /* ------------------------------------------------------------------------- */
 /* Common Ethernet helpers shared by all supported frame engines. */
 
@@ -2047,6 +2053,20 @@ static void airoha_qdma_irq_disable(struct airoha_irq_bank *irq_bank,
 	airoha_qdma_set_irqmask(irq_bank, index, mask, 0);
 }
 
+static u32 airoha_qdma_get_rx_irq_mask(struct airoha_qdma *qdma, int bank)
+{
+	if (airoha_is(qdma->eth, airoha_an7563) && bank == 1)
+		return GENMASK(14, 10);
+
+	return RX_IRQ_BANK_PIN_MASK(bank);
+}
+
+static int airoha_qdma_num_irq_regs(struct airoha_qdma *qdma)
+{
+	return airoha_is(qdma->eth, airoha_an7563) ? 2 :
+		ARRAY_SIZE(qdma->irq_banks[0].irqmask);
+}
+
 static int airoha_qdma_fill_rx_queue(struct airoha_queue *q)
 {
 	struct airoha_qdma *qdma = q->qdma;
@@ -2056,6 +2076,7 @@ static int airoha_qdma_fill_rx_queue(struct airoha_queue *q)
 	while (q->queued < q->ndesc - 1) {
 		struct airoha_queue_entry *e = &q->entry[q->head];
 		struct airoha_qdma_desc *desc = &q->desc[q->head];
+		dma_addr_t dma_addr;
 		struct page *page;
 		int offset;
 		u32 val;
@@ -2069,16 +2090,23 @@ static int airoha_qdma_fill_rx_queue(struct airoha_queue *q)
 		q->queued++;
 		nframes++;
 
+		if (airoha_is(qdma->eth, airoha_an7563))
+			offset += AIROHA_AN7563_RX_HEADROOM;
 		e->buf = page_address(page) + offset;
 		e->dma_addr = page_pool_get_dma_addr(page) + offset;
-		e->dma_len = SKB_WITH_OVERHEAD(q->buf_size);
+		e->dma_len = airoha_is(qdma->eth, airoha_an7563) ?
+			AIROHA_AN7563_RX_DMA_LEN :
+			SKB_WITH_OVERHEAD(q->buf_size);
+		dma_addr = e->dma_addr;
+		if (airoha_is(qdma->eth, airoha_an7563))
+			dma_addr -= NET_IP_ALIGN;
 
 		WRITE_ONCE(desc->tcp_ts_reply, 0);
 		val = airoha_is(qdma->eth, airoha_en7523, econet_en7580) ?
 			FIELD_PREP(EN7523_QDMA_DESC_LEN_MASK, e->dma_len) :
 			FIELD_PREP(QDMA_DESC_LEN_MASK, e->dma_len);
 		WRITE_ONCE(desc->ctrl, cpu_to_le32(val));
-		WRITE_ONCE(desc->addr, cpu_to_le32(e->dma_addr));
+		WRITE_ONCE(desc->addr, cpu_to_le32(dma_addr));
 		val = FIELD_PREP(QDMA_DESC_NEXT_ID_MASK, q->head);
 		WRITE_ONCE(desc->data, cpu_to_le32(val));
 		WRITE_ONCE(desc->msg0, 0);
@@ -2176,6 +2204,7 @@ static struct sk_buff *airoha_qdma_lro_rx_skb(struct airoha_queue *q,
 	case econet_en751221:
 	case econet_en7528:
 	case econet_en7580:
+	case airoha_an7563:
 		return NULL;
 	case airoha_en7523:
 		ipv4 = FIELD_GET(EN7523_QDMA_ETH_RXMSG_IP4_MASK, msg1);
@@ -2406,8 +2435,9 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 		q->tail = (q->tail + 1) % q->ndesc;
 		q->queued--;
 
-		dma_sync_single_for_cpu(eth->dev, e->dma_addr,
-					SKB_WITH_OVERHEAD(q->buf_size), dir);
+		data_len = airoha_is(eth, airoha_an7563) ?
+			e->dma_len : SKB_WITH_OVERHEAD(q->buf_size);
+		dma_sync_single_for_cpu(eth->dev, e->dma_addr, data_len, dir);
 
 		page = virt_to_head_page(e->buf);
 		len = airoha_is(eth, airoha_en7523, econet_en7580) ?
@@ -2419,8 +2449,13 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 			goto free_frag;
 
 		msg0 = le32_to_cpu(READ_ONCE(desc->msg0));
-		if (airoha_is(eth, airoha_en7523) &&
-		    q - &q->qdma->q_rx[0] == 15) {
+		if (q->skb && airoha_is(eth, airoha_an7563)) {
+			msg0 = q->rx_msg0;
+			xpon_oam = false;
+			netdev = q->skb->dev;
+			dev = netdev_priv(netdev);
+		} else if (airoha_is(eth, airoha_en7523) &&
+			   q - &q->qdma->q_rx[0] == 15) {
 			u32 msg2 = le32_to_cpu(READ_ONCE(desc->msg2));
 			u32 msg3 = le32_to_cpu(READ_ONCE(desc->msg3));
 			unsigned int channel, gem_port_id;
@@ -2435,32 +2470,39 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 					     channel, gem_port_id,
 					     !!(msg0 & EN7523_QDMA_ETH_RXMSG_NO_MIC_MASK));
 		}
-		xpon_oam = airoha_is(eth, airoha_en7523) &&
-			   (msg0 & EN7523_QDMA_ETH_RXMSG_OAM_MASK);
+		if (!q->skb || !airoha_is(eth, airoha_an7563)) {
+			xpon_oam = airoha_is(eth, airoha_en7523) &&
+				   (msg0 & EN7523_QDMA_ETH_RXMSG_OAM_MASK);
 
-		/* GPON OAM descriptors are not required to carry an Ethernet
-		 * source port. Resolve them through the registered xPON GDM2
-		 * provider before applying the normal source-port decoder.
-		 */
-		if (xpon_oam)
-			dev = airoha_qdma_get_xpon_dev(eth);
-		else
-			dev = airoha_qdma_get_gdm_dev(
-				eth, airoha_qdma_get_rx_sport(eth, desc));
-		if (IS_ERR(dev)) {
+			/* GPON OAM descriptors are not required to carry an Ethernet
+			 * source port. Resolve them through the registered xPON GDM2
+			 * provider before applying the normal source-port decoder.
+			 */
 			if (xpon_oam)
-				dev_warn_ratelimited(eth->dev,
-						     "xPON OAM RX dropped: no managed GDM2 ring=%td len=%d msg0=%#010x msg1=%#010x\n",
-					q - &q->qdma->q_rx[0], len, msg0,
-					le32_to_cpu(READ_ONCE(desc->msg1)));
-			goto free_frag;
-		}
+				dev = airoha_qdma_get_xpon_dev(eth);
+			else
+				dev = airoha_qdma_get_gdm_dev(eth,
+							      airoha_qdma_get_rx_sport(eth, desc));
+			if (IS_ERR(dev)) {
+				if (xpon_oam)
+					dev_warn_ratelimited(eth->dev,
+							     "xPON OAM RX dropped: no managed GDM2 ring=%td len=%d msg0=%#010x msg1=%#010x\n",
+						q - &q->qdma->q_rx[0], len, msg0,
+						le32_to_cpu(READ_ONCE(desc->msg1)));
+				goto free_frag;
+			}
 
-		netdev = netdev_from_priv(dev);
+			netdev = netdev_from_priv(dev);
+		}
 		if (!q->skb) { /* first buffer */
 			q->skb = airoha_qdma_build_rx_skb(q, desc, e, netdev, xpon_oam);
 			if (!q->skb)
 				goto free_frag;
+
+			if (airoha_is(eth, airoha_an7563)) {
+				q->rx_msg0 = msg0;
+				q->rx_msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
+			}
 		} else { /* scattered frame */
 			struct skb_shared_info *shinfo = skb_shinfo(q->skb);
 			int nr_frags = shinfo->nr_frags;
@@ -2543,14 +2585,13 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 
 		if (netdev_uses_dsa(netdev)) {
 			struct airoha_gdm_port *port = dev->port;
-			u32 msg0, sptag, sport;
+			u32 sptag, sport;
 
 			/* PPE module requires untagged packets to work
 			 * properly and it provides DSA port index via the
 			 * DMA descriptor. Report DSA tag to the DSA stack
 			 * via skb dst info.
 			 */
-			msg0 = le32_to_cpu(READ_ONCE(desc->msg0));
 			if (airoha_is(eth, econet_en7580)) {
 				sptag = FIELD_GET(EN7580_QDMA_ETH_RXMSG_SPTAG,
 						  msg0);
@@ -2569,7 +2610,8 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 						  &port->dsa_meta[sptag]->dst);
 		}
 
-		msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
+		msg1 = airoha_is(eth, airoha_an7563) ?
+			q->rx_msg1 : le32_to_cpu(READ_ONCE(desc->msg1));
 		hash = airoha_is(eth, airoha_en7523, econet_en7580) ?
 		       FIELD_GET(EN7523_QDMA_ETH_RXMSG_PPE_ENTRY_MASK, msg1) :
 		       FIELD_GET(AIROHA_RXD4_FOE_ENTRY, msg1);
@@ -2619,7 +2661,7 @@ static int airoha_qdma_rx_napi_poll(struct napi_struct *napi, int budget)
 							 : QDMA_INT_REG_IDX2;
 
 		for (i = 0; i < qdma->eth->soc->irq_banks; i++) {
-			if (!(BIT(qid) & RX_IRQ_BANK_PIN_MASK(i)))
+			if (!(BIT(qid) & airoha_qdma_get_rx_irq_mask(qdma, i)))
 				continue;
 
 			airoha_qdma_irq_enable(&qdma->irq_banks[i], intr_reg,
@@ -2676,6 +2718,8 @@ static int airoha_qdma_init_rx_queue(struct airoha_queue *q,
 		q->buf_size = SKB_HEAD_ALIGN(EN7523_AIROHA_RXQ_LRO_MAX_AGG_SIZE);
 	else
 		q->buf_size = lro_q ? pp_params.max_len : pp_params.max_len / 2;
+	if (!lro_q && airoha_is(eth, airoha_an7563))
+		q->buf_size = AIROHA_AN7563_RX_BUF_SIZE;
 	q->ndesc = ndesc;
 	netif_napi_add(eth->napi_dev, &q->napi, airoha_qdma_rx_napi_poll);
 
@@ -2689,7 +2733,8 @@ static int airoha_qdma_init_rx_queue(struct airoha_queue *q,
 			FIELD_PREP(RX_RING_THR_MASK, thr));
 	airoha_qdma_rmw(qdma, REG_RX_DMA_IDX(qid), RX_RING_DMA_IDX_MASK,
 			FIELD_PREP(RX_RING_DMA_IDX_MASK, q->head));
-	if (lro_q || (airoha_is(eth, airoha_en7523) && qid == 15))
+	if (lro_q || airoha_is(eth, airoha_an7563) ||
+	    (airoha_is(eth, airoha_en7523) && qid == 15))
 		airoha_qdma_clear(qdma, REG_RX_SCATTER_CFG(qid),
 				  RX_RING_SG_EN_MASK);
 	else
@@ -3094,11 +3139,18 @@ void airoha_qdma_cleanup_tx_queue(struct airoha_queue *q)
 	spin_unlock_bh(&q->lock);
 }
 
+static bool airoha_is_an7563_qdma_wan(struct airoha_qdma *qdma)
+{
+	return airoha_is(qdma->eth, airoha_an7563) &&
+	       qdma == &qdma->eth->qdma[1];
+}
+
 static int airoha_qdma_modern_init_hfwd(struct airoha_qdma *qdma)
 {
 	int size, index, num_desc = HW_DSCP_NUM;
 	struct airoha_eth *eth = qdma->eth;
 	int id = qdma - &eth->qdma[0];
+	bool payload_1k = airoha_is(eth, airoha_an7563) || id;
 	u32 status, buf_size;
 	dma_addr_t dma_addr;
 	const char *name;
@@ -3111,7 +3163,7 @@ static int airoha_qdma_modern_init_hfwd(struct airoha_qdma *qdma)
 	 * Keep the vendor 16K HWFWD descriptors on both instances by using
 	 * 2 KiB payloads on LAN and 1 KiB payloads on WAN.
 	 */
-	buf_size = id ? AIROHA_MAX_PACKET_SIZE / 2 :
+	buf_size = payload_1k ? AIROHA_MAX_PACKET_SIZE / 2 :
 		   AIROHA_MAX_PACKET_SIZE;
 	index = of_property_match_string(eth->dev->of_node,
 					 "memory-region-names", name);
@@ -3159,12 +3211,15 @@ static int airoha_qdma_modern_init_hfwd(struct airoha_qdma *qdma)
 			FIELD_PREP(HW_FWD_DSCP_PAYLOAD_SIZE_MASK,
 				   buf_size != AIROHA_MAX_PACKET_SIZE));
 	airoha_qdma_rmw(qdma, REG_FWD_DSCP_LOW_THR, FWD_DSCP_LOW_THR_MASK,
-			FIELD_PREP(FWD_DSCP_LOW_THR_MASK, 128));
+			FIELD_PREP(FWD_DSCP_LOW_THR_MASK,
+				   airoha_is_an7563_qdma_wan(qdma) ? 256 : 128));
 	airoha_qdma_rmw(qdma, REG_LMGR_INIT_CFG,
 			LMGR_INIT_START | LMGR_SRAM_MODE_MASK |
 			HW_FWD_DESC_NUM_MASK,
 			FIELD_PREP(HW_FWD_DESC_NUM_MASK, num_desc) |
-			LMGR_INIT_START | LMGR_SRAM_MODE_MASK);
+			LMGR_INIT_START |
+			(airoha_is(eth, airoha_an7563) ? 0 :
+			 LMGR_SRAM_MODE_MASK));
 
 	return read_poll_timeout(airoha_qdma_rr, status,
 				 !(status & LMGR_INIT_START), USEC_PER_MSEC,
@@ -3185,7 +3240,8 @@ static void airoha_qdma_init_qos(struct airoha_qdma *qdma)
 	 * QDMA1 is the WAN instance in this driver. Later SoCs explicitly
 	 * keep this estimator disabled, as does EN7523 QDMA LAN.
 	 */
-	if (airoha_is(eth, airoha_en7523) && id == 1)
+	if ((airoha_is(eth, airoha_en7523) && id == 1) ||
+	    airoha_is_an7563_qdma_wan(qdma))
 		airoha_qdma_set(qdma, REG_PSE_BUF_USAGE_CFG,
 				PSE_BUF_ESTIMATE_EN_MASK);
 	else
@@ -3201,7 +3257,8 @@ static void airoha_qdma_init_qos(struct airoha_qdma *qdma)
 	 * leaves equal-rate mode disabled there. QDMA LAN uses the generic
 	 * 2047us x 31 = 63.457ms interval.
 	 */
-	if (airoha_is(eth, airoha_en7523) && id == 1) {
+	if ((airoha_is(eth, airoha_en7523) && id == 1) ||
+	    airoha_is_an7563_qdma_wan(qdma)) {
 		meter_cfg &= ~EGRESS_RATE_METER_EQ_RATE_EN_MASK;
 		meter_window = 20;
 		meter_timeslice = 200; /* 200us x 20 = 4ms */
@@ -3272,28 +3329,38 @@ static void airoha_qdma_init_qos_stats(struct airoha_qdma *qdma)
 
 static int airoha_qdma_modern_hw_init(struct airoha_qdma *qdma)
 {
+	u32 global_cfg;
