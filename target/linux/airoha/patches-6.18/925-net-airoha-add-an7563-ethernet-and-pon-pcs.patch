Subject: [PATCH] net: airoha: add AN7563 Ethernet and PON HSGMII PCS

AN7563 uses the Airoha FE/QDMA and integrated switch, but its PON SerDes
has the earlier HSGMII register layout. Add a separate PCS provider for
2500BASE-X external PHYs, using the AN7563 vendor initialization sequence.
Keep the PCS resets out of the Ethernet driver's reset ownership.

---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -4365,7 +4365,21 @@
 	},
 };
 
+/* AN7563 uses GDM1 for the switch and GDM2 for PON HSGMII.
+ * Its XSI/PHY resets are owned by the PCS driver.
+ */
+static const struct airoha_eth_soc_data an7563_soc_data = {
+	.version = 0x7563,
+	.num_ppe = 2,
+	.ops = {
+		.get_sport = airoha_en7581_get_sport,
+		.get_dev_from_sport = airoha_en7581_get_dev_from_sport,
+		.get_vip_port = airoha_en7581_get_vip_port,
+	},
+};
+
 static const struct of_device_id of_airoha_match[] = {
+	{ .compatible = "airoha,an7563-eth", .data = &an7563_soc_data },
 	{ .compatible = "airoha,en7581-eth", .data = &en7581_soc_data },
 	{ .compatible = "airoha,an7583-eth", .data = &an7583_soc_data },
 	{ /* sentinel */ }
--- a/drivers/net/pcs/airoha/Kconfig
+++ b/drivers/net/pcs/airoha/Kconfig
@@ -17,3 +17,14 @@
 	help
 	  This module provides helper to phylink for managing the Airoha
 	  AN7583 PCS for SoC Ethernet and PON SERDES.
+
+config PCS_AIROHA_AN7563
+	tristate "Airoha AN7563 PON HSGMII PCS"
+	depends on ARCH_AIROHA || COMPILE_TEST
+	select PCS_AIROHA
+	select MFD_SYSCON
+	help
+	  Support the AN7563 PON SerDes connected to an external PHY in
+	  2500BASE-X mode. This block differs from the AN7581 PCS.
+	  The driver configures the 25 MHz SerDes reference clock and
+	  exposes the PCS to phylink for the copper WAN interface.
--- a/drivers/net/pcs/airoha/Makefile
+++ b/drivers/net/pcs/airoha/Makefile
@@ -8,3 +8,4 @@
 ifdef CONFIG_PCS_AIROHA_AN7583
 pcs-airoha-objs			+= pcs-an7583.o
 endif
+obj-$(CONFIG_PCS_AIROHA_AN7563) += pcs-an7563.o
--- /dev/null
+++ b/drivers/net/pcs/airoha/pcs-an7563.c
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
+#include <linux/mii.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pcs/pcs-provider.h>
+#include <linux/phylink.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+
+#define AN7563_WAN_CONF		0x70
+#define AN7563_PCS_INT_EN		0x0
+#define AN7563_PCS_INT_CLEAR	0x4
+#define AN7563_XSI_GLB_CFG	0x0
+#define AN7563_XSI_STOP		GENMASK(3, 0)
+#define AN7563_XSI_PAUSE		GENMASK(5, 4)
+#define AN7563_XSI_TXMPI_MASK	BIT(9)
+#define AN7563_XSI_IPG		GENMASK(15, 10)
+
+struct an7563_pcs {
+	struct phylink_pcs pcs;
+	void __iomem *mac;
+	void __iomem *an;
+	void __iomem *pma;
+	void __iomem *irq;
+	struct regmap *scu;
+	struct reset_control_bulk_data resets[3];
+};
+
+/* Offsets relative to the AN7563 PON PHY window at 0x1faf3000.
+ * 25 MHz crystal, forced HSGMII (2.5 Gbit/s), as used by the vendor BSP.
+ */
+static const struct {
+	u32 reg;
+	u32 val;
+} an7563_hsgmii_init[] = {
+	{ 0x1130, 0x64000000 }, /* LCPLL reference clock */
+	{ 0x1228, 0x00000103 }, /* SerDes control */
+	{ 0x1364, 0x00003003 }, /* Frequency detector */
+	{ 0x136c, 0x15601560 },
+	{ 0x0028, 0x18001722 }, /* CDR */
+	{ 0x1300, 0x250003c0 }, /* Clock enable/select */
+	{ 0x1310, 0x0000003f }, /* HSGMII reset release */
+	{ 0x1608, 0x54101801 },
+	{ 0x1530, 0x00380013 },
+	{ 0x1320, 0x00000011 }, /* Oversampling */
+	{ 0x1314, 0x00000001 }, /* HSGMII mode */
+	{ 0x1300, 0x240003c0 },
+	{ 0x113c, 0x00010100 }, /* LCPLL latch */
+	{ 0x1134, 0x20000100 },
+	{ 0x113c, 0x01010100 },
+	{ 0x1200, 0x00100381 },
+};
+
+static struct an7563_pcs *pcs_to_an7563(struct phylink_pcs *pcs)
+{
+	return container_of(pcs, struct an7563_pcs, pcs);
+}
+
+static unsigned int an7563_pcs_inband_caps(struct phylink_pcs *pcs,
+					   phy_interface_t interface)
+{
+	return interface == PHY_INTERFACE_MODE_2500BASEX ? LINK_INBAND_DISABLE : 0;
+}
+
+static int an7563_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
+			     phy_interface_t interface,
+			     const unsigned long *advertising, bool permit_pause)
+{
+	struct an7563_pcs *priv = pcs_to_an7563(pcs);
+	u32 val;
+	int i, err;
+
+	if (interface != PHY_INTERFACE_MODE_2500BASEX ||
+	    neg_mode == PHYLINK_PCS_NEG_INBAND_ENABLED)
+		return -EINVAL;
+
+	val = readl(priv->mac + AN7563_XSI_GLB_CFG);
+	err = reset_control_assert(priv->resets[0].rstc);
+	if (err)
+		return err;
+	err = reset_control_deassert(priv->resets[0].rstc);
+	if (err)
+		return err;
+	usleep_range(10000, 11000);
+
+	err = reset_control_bulk_assert(2, &priv->resets[1]);
+	if (err)
+		return err;
+	err = reset_control_bulk_deassert(2, &priv->resets[1]);
+	if (err)
+		return err;
+
+	writel(an7563_hsgmii_init[0].val, priv->pma + an7563_hsgmii_init[0].reg);
+	err = regmap_write(priv->scu, AN7563_WAN_CONF, 0xe0000011);
+	if (err)
+		return err;
+
+	writel(BMCR_SPEED1000 | BMCR_FULLDPLX, priv->an + MII_BMCR * 4);
+	for (i = 1; i < ARRAY_SIZE(an7563_hsgmii_init); i++)
+		writel(an7563_hsgmii_init[i].val,
+		       priv->pma + an7563_hsgmii_init[i].reg);
+
+	writel(BMCR_RESET | BMCR_SPEED1000 | BMCR_FULLDPLX, priv->an);
+	usleep_range(10, 20);
+	writel(BMCR_SPEED1000 | BMCR_FULLDPLX, priv->an);
+
+	writel(val | AN7563_XSI_STOP | AN7563_XSI_TXMPI_MASK, priv->mac);
+	writel(0, priv->irq + AN7563_PCS_INT_EN);
+	writel(0x3ff, priv->irq + AN7563_PCS_INT_CLEAR);
+	val &= ~(AN7563_XSI_STOP | AN7563_XSI_TXMPI_MASK | AN7563_XSI_IPG);
+	val |= FIELD_PREP(AN7563_XSI_IPG, 10) | AN7563_XSI_PAUSE;
+	writel(val, priv->mac + AN7563_XSI_GLB_CFG);
+
+	return 0;
+}
+
+static void an7563_pcs_get_state(struct phylink_pcs *pcs, unsigned int neg_mode,
+				 struct phylink_link_state *state)
+{
+	struct an7563_pcs *priv = pcs_to_an7563(pcs);
+
+	readl(priv->an + MII_BMSR * 4);
+	state->link = !!(readl(priv->an + MII_BMSR * 4) & BMSR_LSTATUS);
+	state->speed = SPEED_2500;
+	state->duplex = DUPLEX_FULL;
+	state->pause = MLO_PAUSE_RX | MLO_PAUSE_TX;
+}
+
+static const struct phylink_pcs_ops an7563_pcs_ops = {
+	.pcs_inband_caps = an7563_pcs_inband_caps,
+	.pcs_config = an7563_pcs_config,
+	.pcs_get_state = an7563_pcs_get_state,
+};
+
+static int an7563_pcs_probe(struct platform_device *pdev)
+{
+	struct fwnode_pcs_provider *provider;
+	struct device *dev = &pdev->dev;
+	struct an7563_pcs *priv;
+	int err;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->mac = devm_platform_ioremap_resource_byname(pdev, "mac");
+	if (IS_ERR(priv->mac))
+		return PTR_ERR(priv->mac);
+	priv->an = devm_platform_ioremap_resource_byname(pdev, "an");
+	if (IS_ERR(priv->an))
+		return PTR_ERR(priv->an);
+	priv->pma = devm_platform_ioremap_resource_byname(pdev, "pma");
+	if (IS_ERR(priv->pma))
+		return PTR_ERR(priv->pma);
+	priv->irq = devm_platform_ioremap_resource_byname(pdev, "irq");
+	if (IS_ERR(priv->irq))
+		return PTR_ERR(priv->irq);
+	priv->scu = syscon_regmap_lookup_by_phandle(dev->of_node, "airoha,scu");
+	if (IS_ERR(priv->scu))
+		return PTR_ERR(priv->scu);
+
+	priv->resets[0].id = "pon-phy";
+	priv->resets[1].id = "xsi-mac";
+	priv->resets[2].id = "xsi-phy";
+	err = devm_reset_control_bulk_get_exclusive(dev, ARRAY_SIZE(priv->resets),
+						    priv->resets);
+	if (err)
+		return dev_err_probe(dev, err, "Failed to get PCS resets\n");
+
+	priv->pcs.ops = &an7563_pcs_ops;
+	priv->pcs.poll = true;
+	__set_bit(PHY_INTERFACE_MODE_2500BASEX, priv->pcs.supported_interfaces);
+	provider = devm_fwnode_pcs_add_provider(dev, dev_fwnode(dev),
+						fwnode_pcs_simple_xlate, &priv->pcs);
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static const struct of_device_id an7563_pcs_match[] = {
+	{ .compatible = "airoha,an7563-pcs-pon" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, an7563_pcs_match);
+
+static struct platform_driver an7563_pcs_driver = {
+	.probe = an7563_pcs_probe,
+	.driver = {
+		.name = "airoha-an7563-pcs",
+		.of_match_table = an7563_pcs_match,
+	},
+};
+module_platform_driver(an7563_pcs_driver);
+
+MODULE_DESCRIPTION("Airoha AN7563 PON HSGMII PCS");
+MODULE_LICENSE("GPL");
