From: Chen Minqiang <ptpt52@gmail.com>
Subject: [PATCH] net: pcs: airoha: require optical hooks for PON line APIs

The AN7563 copper PCS also has PON port type, but has no optical line
callbacks. Reject the optical API before touching its distinct PMA
registers or dereferencing an absent callback.

Signed-off-by: Chen Minqiang <ptpt52@gmail.com>
---
--- a/drivers/net/pcs/airoha/pcs-airoha-common.c
+++ b/drivers/net/pcs/airoha/pcs-airoha-common.c
@@ -211,7 +211,8 @@ int airoha_pcs_pon_config_rx(struct phyl
 	priv = port->priv;
 
 	/* DTS and SoC match data provide the AN7581 and AN7583 register windows. */
-	if (priv->data->port_type != AIROHA_PCS_PON)
+	if (priv->data->port_type != AIROHA_PCS_PON ||
+	    !priv->data->pon_start_rx)
 		return -EOPNOTSUPP;
 
 	switch (mode) {
@@ -315,7 +316,8 @@ int airoha_pcs_pon_retrain_rx(struct phy
 
 	port = to_airoha_pcs_port(pcs);
 	priv = port->priv;
-	if (priv->data->port_type != AIROHA_PCS_PON)
+	if (priv->data->port_type != AIROHA_PCS_PON ||
+	    !priv->data->pon_start_rx)
 		return -EOPNOTSUPP;
 
 	mode = priv->pon_mode;
@@ -343,7 +345,8 @@ int airoha_pcs_pon_stop_rx(struct phylin
 
 	port = to_airoha_pcs_port(pcs);
 	priv = port->priv;
-	if (priv->data->port_type != AIROHA_PCS_PON)
+	if (priv->data->port_type != AIROHA_PCS_PON ||
+	    !priv->data->pon_start_rx)
 		return -EOPNOTSUPP;
 
 	return priv->data->pon_stop_rx(priv, port->index);
@@ -363,7 +366,8 @@ int airoha_pcs_pon_get_rx_status(struct
 
 	port = to_airoha_pcs_port(pcs);
 	priv = port->priv;
-	if (priv->data->port_type != AIROHA_PCS_PON)
+	if (priv->data->port_type != AIROHA_PCS_PON ||
+	    !priv->data->pon_start_rx)
 		return -EOPNOTSUPP;
 
 	/* Read PON state from sigdet while DIG_RESERVE_0 retains the RX rate. */
