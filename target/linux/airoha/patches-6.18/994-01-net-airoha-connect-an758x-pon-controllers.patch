+int airoha_eth_pon_replace_flows(
+	struct net_device *netdev, const struct airoha_pon_flow_config *flows,
+	unsigned int count)
+{
+	struct airoha_pon_flow_table *table = NULL, *old;
+	struct airoha_gdm_dev *dev;
+	unsigned int i, j;
+
+	if (!airoha_is_netdev(netdev))
+		return -EINVAL;
+	dev = netdev_priv(netdev);
+	if (!(dev->flags & AIROHA_PRIV_F_PON))
+		return -EOPNOTSUPP;
+	if (count > 32 || (count && !flows))
+		return -EINVAL;
+	if (count) {
+		table = kzalloc(struct_size(table, entries, count), GFP_KERNEL);
+		if (!table)
+			return -ENOMEM;
+		table->count = count;
+		for (i = 0; i < count; i++) {
+			if (flows[i].tcont >= 32 ||
+			    (flows[i].vlan_id > 4094 &&
+			     flows[i].vlan_id != AIROHA_PON_VID_ANY) ||
+			    !flows[i].pbit_mask) {
+				kfree(table);
+				return -EINVAL;
+			}
+			/*
+			 * VID_ANY matches untagged frames and follows exact VID lookup.
+			 * Duplicate VID and P-bit keys conflict.
+			 */
+			for (j = 0; j < i; j++)
+				if (flows[i].vlan_id == flows[j].vlan_id &&
+				    flows[i].pbit_mask & flows[j].pbit_mask) {
+					kfree(table);
+					return -EINVAL;
+				}
+			table->entries[i].vlan_id = flows[i].vlan_id;
+			table->entries[i].pbit_mask = flows[i].pbit_mask;
+			table->entries[i].tag = AIROHA_PON_QDMA_VALID |
+				FIELD_PREP(AIROHA_PON_QDMA_TCONT_MASK,
+					   flows[i].tcont) |
+				FIELD_PREP(AIROHA_PON_QDMA_GEM_MASK,
+					   flows[i].gem_id) |
+				FIELD_PREP(AIROHA_PON_QDMA_PBIT_MASK,
+					   flows[i].pbit_mask);
+		}
+	}
+
+	mutex_lock(&flow_offload_mutex);
+	old = rcu_replace_pointer(dev->pon_flow_table, table,
+				  lockdep_is_held(&flow_offload_mutex));
+	WRITE_ONCE(dev->pon_qdma_tag, 0);
+	mutex_unlock(&flow_offload_mutex);
+	synchronize_net();
+	kfree(old);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_replace_flows);
+
+int airoha_eth_pon_configure(struct net_device *netdev, u8 tcont,
+			     u16 gem_id, bool valid)
+{
+	struct airoha_pon_flow_config flow = {
+		.tcont = tcont,
+		.gem_id = gem_id,
+		.vlan_id = AIROHA_PON_VID_ANY,
+		.pbit_mask = 0xff,
+	};
+
+	return airoha_eth_pon_replace_flows(netdev, valid ? &flow : NULL,
+					    valid ? 1 : 0);
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_configure);
+
+int airoha_eth_pon_configure_epon(struct net_device *netdev, u8 channel,
+				  bool valid)
+{
+	struct airoha_gdm_dev *dev;
+	u32 value = 0;
+
+	if (!airoha_is_netdev(netdev))
+		return -EINVAL;
+	dev = netdev_priv(netdev);
+	if (!(dev->flags & AIROHA_PRIV_F_PON))
+		return -EOPNOTSUPP;
+	if (valid && channel >= 32)
+		return -ERANGE;
+	airoha_eth_pon_replace_flows(netdev, NULL, 0);
+	if (valid)
+		value = AIROHA_PON_QDMA_VALID | AIROHA_PON_QDMA_EPON |
+			FIELD_PREP(AIROHA_PON_QDMA_TCONT_MASK, channel);
+
+	WRITE_ONCE(dev->pon_qdma_tag, value);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_configure_epon);
