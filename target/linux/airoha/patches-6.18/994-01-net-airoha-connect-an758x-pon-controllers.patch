+	u64 rx_runt_frames;
+	u64 rx_long_frames;
+	u64 tx_channel_packets[AIROHA_PON_MAX_QDMA_CHANNELS];
+	u64 rx_channel_packets[AIROHA_PON_MAX_QDMA_CHANNELS];
+	u32 last_tx_msg0;
+	u32 last_tx_msg1;
+	u32 last_rx_msg0;
+	u32 last_rx_msg1;
+};
