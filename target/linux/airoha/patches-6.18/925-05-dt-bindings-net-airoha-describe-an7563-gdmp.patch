From: PTPT52.AI <ptpt52@gmail.com>
Date: Sun, 20 Sep 2026 15:00:00 +0800
Subject: [PATCH] dt-bindings: net: airoha: describe AN7563 GDMP SRAM

The AN7563 extends the Frame Engine packet-switching buffer with SRAM
from the GDMP block.  Describe the GDMP syscon and the phandles used by
the Ethernet controller to select the SRAM and its clock owner.

Signed-off-by: PTPT52.AI <ptpt52@gmail.com>
---
 .../bindings/mfd/airoha,an7563-gdmp.yaml      | 44 +++++++++++++++++++
 .../bindings/net/airoha,en7581-eth.yaml       | 28 +++++++++++-
 2 files changed, 71 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/devicetree/bindings/mfd/airoha,an7563-gdmp.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/airoha,an7563-gdmp.yaml
@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/airoha,an7563-gdmp.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha AN7563 GDMP controller
+
+maintainers:
+  - Lorenzo Bianconi <lorenzo@kernel.org>
+
+description:
+  The GDMP controller contains a small SRAM which can be assigned to the
+  Frame Engine packet-switching buffer or used for packet capture and PBUS
+  access.
+
+properties:
+  compatible:
+    items:
+      - const: airoha,an7563-gdmp
+      - const: syscon
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+      #address-cells = <1>;
+      #size-cells = <1>;
+
+      syscon@1fbf9000 {
+        compatible = "airoha,an7563-gdmp", "syscon";
+        reg = <0x1fbf9000 0x84>;
+      };
+    };
+
+...
--- a/Documentation/devicetree/bindings/net/airoha,en7581-eth.yaml
+++ b/Documentation/devicetree/bindings/net/airoha,en7581-eth.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/net/airoha,en7581-eth.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Airoha EN7581 Frame Engine Ethernet controller
+title: Airoha Frame Engine Ethernet controller
 
 maintainers:
   - Lorenzo Bianconi <lorenzo@kernel.org>
@@ -17,5 +17,6 @@ properties:
   compatible:
     enum:
+      - airoha,an7563-eth
       - airoha,en7581-eth
 
   reg:
@@ -72,5 +73,16 @@ properties:
       Processor Engine (PPE) flow table.
 
+  airoha,gdmp:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the GDMP controller whose SRAM extends the AN7563 PSE
+      packet buffer.
+
+  airoha,scu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the system controller which selects the SRAM clock owner.
+
 patternProperties:
   "^ethernet@[1-4]$":
     type: object
@@ -99,6 +111,20 @@ required:
   - resets
   - reset-names
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: airoha,an7563-eth
+    then:
+      required:
+        - airoha,gdmp
+        - airoha,scu
+    else:
+      properties:
+        airoha,gdmp: false
+        airoha,scu: false
+
 unevaluatedProperties: false
 
 examples:
