+
+static int airoha_ppe_smac_write(struct airoha_ppe *ppe, unsigned int id,
+				 const u8 *addr)
+{
+	struct airoha_eth *eth = ppe->common.eth;
+	u32 data[] = { get_unaligned_be32(addr + 2),
+		       get_unaligned_be16(addr) };
+	int i, offset, err;
+	u32 val;
+
+	lockdep_assert_held(&ppe->smac_lock);
+
+	/* Flows can bind in either PPE, so use identical indices in both. */
+	for (i = 0; i < eth->soc->num_ppe; i++) {
+		for (offset = 0; offset < ARRAY_SIZE(data); offset++) {
+			airoha_fe_wr(eth, REG_UPDMEM_DATA(i), data[offset]);
+			airoha_fe_wr(eth, REG_UPDMEM_CTRL(i),
+				     FIELD_PREP(PPE_UPDMEM_ADDR_MASK, id) |
+				     FIELD_PREP(PPE_UPDMEM_OFFSET_MASK, offset) |
+				     PPE_UPDMEM_WR_MASK | PPE_UPDMEM_REQ_MASK);
+			err = read_poll_timeout_atomic(airoha_fe_rr, val,
+						       val & PPE_UPDMEM_ACK_MASK,
+						       1, 100, false, eth,
+						       REG_UPDMEM_CTRL(i));
+			if (err) {
+				dev_err_ratelimited(eth->dev,
+						    "Timeout programming PPE %d SMAC slot %u\n",
+						    i, id);
+				return err;
+			}
+		}
+	}
+
+	return 0;
+}
+
+static int airoha_ppe_smac_get(struct airoha_ppe *ppe,
+			       struct airoha_flow_table_entry *e,
+			       const u8 *addr)
+{
+	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1);
+	struct airoha_ppe_smac *slot;
+	unsigned long flags;
+	int i, free = -1, err = 0;
+
+	if ((type != PPE_PKT_TYPE_IPV6_ROUTE_3T &&
+	     type != PPE_PKT_TYPE_IPV6_ROUTE_5T) ||
+	    !(e->data.ib1 & AIROHA_FOE_IB1_BIND_TTL))
+		return 0;
+	if (!is_valid_ether_addr(addr))
+		return -EINVAL;
+
+	spin_lock_irqsave(&ppe->smac_lock, flags);
+	for (i = 0; i < ARRAY_SIZE(ppe->smac); i++) {
+		slot = &ppe->smac[i];
+		if (slot->valid && ether_addr_equal(slot->addr, addr))
+			goto found;
+		if (!slot->refs && free < 0)
+			free = i;
+	}
+	if (free < 0) {
+		err = -ENOSPC;
+		goto unlock;
+	}
+	if (ppe->smac_failed) {
+		err = -EIO;
+		goto unlock;
+	}
+
+	i = free;
+	slot = &ppe->smac[i];
+	slot->valid = false;
+	err = airoha_ppe_smac_write(ppe, i, addr);
+	if (err) {
+		/* A late ACK must not race another UPDMEM transaction. Existing
+		 * successfully programmed slots remain usable without writes.
+		 */
+		ppe->smac_failed = true;
+		goto unlock;
+	}
+	ether_addr_copy(slot->addr, addr);
+	slot->valid = true;
+found:
+	slot->refs++;
+	e->smac_ref = true;
+	e->data.ipv6.l2.src_mac_hi &= ~AIROHA_FOE_MAC_SMAC_ID;
+	e->data.ipv6.l2.src_mac_hi |= FIELD_PREP(AIROHA_FOE_MAC_SMAC_ID, i);
+unlock:
+	spin_unlock_irqrestore(&ppe->smac_lock, flags);
+
+	return err;
+}
+
+static void airoha_ppe_smac_put(struct airoha_ppe *ppe,
+				struct airoha_flow_table_entry *e)
+{
+	unsigned int id = FIELD_GET(AIROHA_FOE_MAC_SMAC_ID,
+				    e->data.ipv6.l2.src_mac_hi);
+	unsigned long flags;
+
+	if (!e->smac_ref)
+		return;
+
+	spin_lock_irqsave(&ppe->smac_lock, flags);
+	if (WARN_ON_ONCE(id >= ARRAY_SIZE(ppe->smac) || !ppe->smac[id].refs))
+		goto unlock;
+	ppe->smac[id].refs--;
+	e->smac_ref = false;
+unlock:
+	spin_unlock_irqrestore(&ppe->smac_lock, flags);
+}
+
+static bool
+airoha_ppe_foe_slot_busy(struct airoha_ppe *ppe,
+			struct airoha_flow_table_entry *owner, u32 index)
+{
+	lockdep_assert_held(&ppe_lock);
+	return ppe->foe_owner && ppe->foe_owner[index] &&
+	       ppe->foe_owner[index] != owner;
+}
+
+static void
+airoha_ppe_foe_reserve_slot(struct airoha_ppe *ppe,
+   			struct airoha_flow_table_entry *owner, u32 index)
+{
+	lockdep_assert_held(&ppe_lock);
+	if (ppe->foe_owner)
+		ppe->foe_owner[index] = owner;
+}
 
