 DEFINE_MUTEX(flow_offload_mutex);
 static DEFINE_SPINLOCK(ppe_lock);
 
+#define AN7563_PPE_GLO_CFG		0x00078743
+#define AN7563_PPE_FLOW_CFG		0x06b97700
+#define AN7563_PPE_IP_PROTO_CHK		0x000f000f
+#define AN7563_PPE_IP_PROTO0		0x04291106
+#define AN7563_PPE_IP_PROTO1		0x00003a01
+#define AN7563_PPE_TB_CFG		0x87c0ffb4
+#define AN7563_PPE_BIND_RATE		0x001e001e
+#define AN7563_PPE_BIND_LIMIT0		0x0fa00fa0
+#define AN7563_PPE_BIND_LIMIT1		0x00011f40
+/* Keepalive interval in hardware scan periods. */
+#define AN7563_PPE_KEEPALIVE_SCANS	2
+#define AN7563_PPE_KEEPALIVE					\
+	(FIELD_PREP(PPE_KEEPALIVE_UDP_MASK, AN7563_PPE_KEEPALIVE_SCANS) | \
+	 FIELD_PREP(PPE_KEEPALIVE_TCP_MASK, AN7563_PPE_KEEPALIVE_SCANS) | \
+	 FIELD_PREP(PPE_KEEPALIVE_NTU_MASK, AN7563_PPE_KEEPALIVE_SCANS))
+#define AN7563_PPE_UNBIND_AGE		0x03e80003
+#define AN7563_PPE_BIND_AGE_UDP		12
+#define AN7563_PPE_BIND_AGE_TCP		7
+#define AN7563_PPE_BIND_AGE_TCP_FIN	1
+#define AN7563_PPE_BIND_AGE_NON_L4	1
+#define AN7563_PPE_BND_AGE0					\
+	(FIELD_PREP(PPE_BIND_AGE0_DELTA_NON_L4, AN7563_PPE_BIND_AGE_NON_L4) | \
+	 FIELD_PREP(PPE_BIND_AGE0_DELTA_UDP, AN7563_PPE_BIND_AGE_UDP))
+#define AN7563_PPE_BND_AGE1					\
+	(FIELD_PREP(PPE_BIND_AGE1_DELTA_TCP_FIN, AN7563_PPE_BIND_AGE_TCP_FIN) | \
+	 FIELD_PREP(PPE_BIND_AGE1_DELTA_TCP, AN7563_PPE_BIND_AGE_TCP))
+#define AN7563_PPE_TB_HASH_CFG		0x31000011
+#define AN7563_PPE_MIRROR		0x00000021
+#define AN7563_PPE_L2B_CFG		0x001d077f
+#define AN7563_PPE_L2B_ETYPE_EN		0x0000001b
+#define AN7563_PPE_L2B_ETYPE0		0x88a88100
+#define AN7563_PPE_L2B_ETYPE1		0x08000000
+#define AN7563_PPE_L2B_ETYPE2		0x000086dd
