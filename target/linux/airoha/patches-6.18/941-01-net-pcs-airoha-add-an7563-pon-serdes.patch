From: X-WRT <dev@x-wrt.com>
Date: Fri, 25 Sep 2026 02:40:00 +0800
Subject: [PATCH] net: pcs: airoha: add AN7563 PON SerDes

Add a PCS provider for the AN7563 PON SerDes connected to an external
PHY in 2500BASE-X mode.  Configure the 25 MHz reference clock, analog
SerDes sequence, and persistent WAN selector required by this block.

Register the PCS through the managed firmware provider API.

Signed-off-by: X-WRT <dev@x-wrt.com>
---
diff --git a/drivers/net/pcs/airoha/Kconfig b/drivers/net/pcs/airoha/Kconfig
index 0214ba7..539e607 100644
--- a/drivers/net/pcs/airoha/Kconfig
+++ b/drivers/net/pcs/airoha/Kconfig
@@ -17,3 +17,14 @@ config PCS_AIROHA_AN7583
 	help
 	  This module provides helper to phylink for managing the Airoha
 	  AN7583 PCS for SoC Ethernet and PON SERDES.
+
+config PCS_AIROHA_AN7563
+	tristate "Airoha AN7563 PON HSGMII PCS"
+	depends on ARCH_AIROHA || COMPILE_TEST
+	select PCS_AIROHA
+	select MFD_SYSCON
+	help
+	  Support the AN7563 PON SerDes connected to an external PHY in
+	  2500BASE-X mode. This analog block differs from the AN7581 PCS.
+	  The driver configures the 25 MHz SerDes reference clock and
+	  exposes the PCS to phylink for the copper WAN interface.
diff --git a/drivers/net/pcs/airoha/Makefile b/drivers/net/pcs/airoha/Makefile
index 69b8b0a..60a21fd 100644
--- a/drivers/net/pcs/airoha/Makefile
+++ b/drivers/net/pcs/airoha/Makefile
@@ -8,3 +8,4 @@ endif
 ifdef CONFIG_PCS_AIROHA_AN7583
 pcs-airoha-objs			+= pcs-an7583.o
 endif
+obj-$(CONFIG_PCS_AIROHA_AN7563) += pcs-an7563.o
diff --git b/drivers/net/pcs/airoha/pcs-an7563.c b/drivers/net/pcs/airoha/pcs-an7563.c
new file mode 100644
index 0000000..a45f7ee
--- /dev/null
+++ b/drivers/net/pcs/airoha/pcs-an7563.c
@@ -0,0 +1,452 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
+#include <linux/mii.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pcs/pcs-provider.h>
+#include <linux/phylink.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+
+#include "pcs-airoha.h"
+
+#define AN7563_SCU_WAN_CONF		0x70
+#define AN7563_SCU_WAN_SEL		GENMASK(7, 0)
+#define AN7563_SCU_WAN_SEL_HSGMII	0x11
+#define AN7563_SCU_SSTR			0x9c
+#define AN7563_SCU_PON_XSI_SEL		GENMASK(10, 9)
+#define AN7563_SCU_PON_XSI_HSGMII	FIELD_PREP(AN7563_SCU_PON_XSI_SEL, 2)
+#define AN7563_SCU_RST_CFG		0x830
+#define AN7563_SCU_XSI_RST		(BIT(7) | BIT(8))
+
+#define AN7563_PHYA_XTAL_CTRL		0x08
+#define AN7563_PHYA_XTAL_RESERVE_6	BIT(22)
+#define AN7563_PHYA_PLL_LDO_CTRL		0x10
+#define AN7563_PHYA_PLL_LDO_MASK		GENMASK(19, 12)
+#define AN7563_PHYA_PLL_LDOLPF_1		FIELD_PREP(GENMASK(17, 16), 1)
+#define AN7563_PHYA_PLL_SDM_CTRL		0x14
+#define AN7563_PHYA_PLL_RESERVE_1	BIT(24)
+#define AN7563_PHYA_CDR_RESERVE		0x18
+#define AN7563_PHYA_CDR_RESERVE_MASK	GENMASK(7, 0)
+#define AN7563_PHYA_CDR_CTRL		0x24
+#define AN7563_PHYA_CDR_EPEN		BIT(12)
+#define AN7563_PHYA_RX_DAC_PWD		BIT(27)
+
+#define AN7563_PMA_LCPLL_NCPO		0x130
+#define AN7563_PMA_LCPLL_NCPO_MASK	GENMASK(30, 0)
+#define AN7563_PMA_LCPLL_NCPO_HSGMII	0x7d000000
+#define AN7563_PMA_LCPLL_LOAD		0x134
+#define AN7563_PMA_LCPLL_LOAD_EN		BIT(8)
+#define AN7563_PMA_LCPLL_CHANGE		0x13c
+#define AN7563_PMA_LCPLL_CHANGE_EN	BIT(24)
+#define AN7563_PMA_SERDES_CTRL_0		0x200
+#define AN7563_PMA_PHYA_AUTO_INIT	BIT(0)
+#define AN7563_PMA_SERDES_CTRL_10	0x228
+#define AN7563_PMA_TX_POLARITY		BIT(8)
+#define AN7563_PMA_SYS_CTRL_0		0x300
+#define AN7563_PMA_SYS_CLK_MASK		(GENMASK(9, 4) | GENMASK(26, 24) | \
+					 GENMASK(29, 28))
+#define AN7563_PMA_SYS_CLK_HSGMII	(GENMASK(9, 6) | BIT(26) | BIT(29))
+#define AN7563_PMA_HG_RST_CTRL_0		0x310
+#define AN7563_PMA_HG_RST_RELEASE	GENMASK(5, 0)
+#define AN7563_PMA_HG_MODE_CTRL_0	0x314
+#define AN7563_PMA_HSGMII_MODE		BIT(0)
+#define AN7563_PMA_OSR_SEL_CTRL		0x320
+#define AN7563_PMA_OSR_MASK		(GENMASK(1, 0) | BIT(4))
+#define AN7563_PMA_OSR_HSGMII		(BIT(0) | BIT(4))
+#define AN7563_PMA_CDR_CTRL_0		0x324
+#define AN7563_PMA_CDR_BIR_LTR_0		GENMASK(4, 0)
+#define AN7563_PMA_CDR_BIC_LTR_1		GENMASK(23, 20)
+#define AN7563_PMA_CDR_CTRL_1		0x328
+#define AN7563_PMA_CDR_BC_LTR_0		GENMASK(4, 0)
+#define AN7563_PMA_CDR_CTRL_3		0x330
+#define AN7563_PMA_CDR_BC_LTD0_0	GENMASK(4, 0)
+#define AN7563_PMA_CDR_CTRL_5		0x338
+#define AN7563_PMA_CDR_BC_LTD1_0	GENMASK(4, 0)
+#define AN7563_PMA_FREQ_CTRL_2		0x364
+#define AN7563_PMA_HG_FREQ_MUX		GENMASK(11, 10)
+#define AN7563_PMA_FREQ_CTRL_4		0x36c
+#define AN7563_PMA_HG_TX_FREQ_CNT	GENMASK(11, 0)
+#define AN7563_PMA_HG_RX_FREQ_CNT	GENMASK(27, 16)
+#define AN7563_PMA_RXFEDIG_CTRL_0	0x500
+#define AN7563_PMA_EQ_RX500M_CK_SEL	BIT(12)
+#define AN7563_PMA_RXFEDIG_CTRL_12	0x530
+#define AN7563_PMA_EQ_REV		GENMASK(31, 16)
+#define AN7563_PMA_DA_CTRL_0		0x600
+#define AN7563_PMA_PLL_FBKSEL		GENMASK(13, 12)
+#define AN7563_PMA_PLL_IR		GENMASK(23, 20)
+#define AN7563_PMA_PLL_BR		GENMASK(26, 24)
+#define AN7563_PMA_DA_CTRL_1		0x604
+#define AN7563_PMA_PLL_BC		GENMASK(5, 4)
+#define AN7563_PMA_DA_CTRL_2		0x608
+#define AN7563_PMA_CDR_PI_PWD		BIT(25)
+#define AN7563_PMA_DA_CTRL_4		0x610
+#define AN7563_PMA_PLL_FBKDIV		GENMASK(8, 0)
+#define AN7563_PMA_DA_CTRL_19		0x64c
+#define AN7563_PMA_PLL_BPA		GENMASK(3, 0)
+#define AN7563_PCS_STATE_2		0x104
+#define AN7563_PCS_RX_SYNC		BIT(5)
+#define AN7563_PCS_AN_DONE		BIT(0)
+
+struct an7563_pcs {
+	struct phylink_pcs pcs;
+	struct device *dev;
+	void __iomem *mac;
+	void __iomem *an;
+	void __iomem *hsgmii_pcs;
+	void __iomem *multi_sgmii;
+	void __iomem *rate_adp;
+	void __iomem *phya;
+	void __iomem *pma;
+	struct regmap *scu;
+	struct reset_control *mac_rst;
+	struct reset_control *phy_rst;
+	int pre_config_err;
+};
+
+static struct an7563_pcs *pcs_to_an7563(struct phylink_pcs *pcs)
+{
+	return container_of(pcs, struct an7563_pcs, pcs);
+}
+
+static void an7563_update(void __iomem *base, u32 reg, u32 mask, u32 val)
+{
+	u32 data = readl(base + reg);
+
+	data &= ~mask;
+	data |= val & mask;
+	writel(data, base + reg);
+}
+
+static void an7563_pcs_analog_init(struct an7563_pcs *priv)
+{
+	/* AN7552/AN7563 vendor 25 MHz reference-clock HSGMII sequence. */
+	an7563_update(priv->pma, AN7563_PMA_RXFEDIG_CTRL_0,
+		      AN7563_PMA_EQ_RX500M_CK_SEL, 0);
+	an7563_update(priv->pma, AN7563_PMA_CDR_CTRL_3,
+		      AN7563_PMA_CDR_BC_LTD0_0, 0x1e);
+	an7563_update(priv->pma, AN7563_PMA_CDR_CTRL_5,
+		      AN7563_PMA_CDR_BC_LTD1_0, 0x1e);
+	an7563_update(priv->pma, AN7563_PMA_CDR_CTRL_1,
+		      AN7563_PMA_CDR_BC_LTR_0, 0x1e);
+	an7563_update(priv->pma, AN7563_PMA_CDR_CTRL_0,
+		      AN7563_PMA_CDR_BIR_LTR_0 | AN7563_PMA_CDR_BIC_LTR_1,
+		      FIELD_PREP(AN7563_PMA_CDR_BIR_LTR_0, 0x10) |
+		      FIELD_PREP(AN7563_PMA_CDR_BIC_LTR_1, 0xf));
+
+	an7563_update(priv->phya, AN7563_PHYA_CDR_CTRL,
+		      AN7563_PHYA_CDR_EPEN, 0);
+	an7563_update(priv->phya, AN7563_PHYA_CDR_RESERVE,
+		      AN7563_PHYA_CDR_RESERVE_MASK, 0);
+	an7563_update(priv->phya, AN7563_PHYA_PLL_LDO_CTRL,
+		      AN7563_PHYA_PLL_LDO_MASK, AN7563_PHYA_PLL_LDOLPF_1);
+
+	an7563_update(priv->pma, AN7563_PMA_DA_CTRL_0,
+		      AN7563_PMA_PLL_IR | AN7563_PMA_PLL_BR,
+		      FIELD_PREP(AN7563_PMA_PLL_IR, 9) |
+		      FIELD_PREP(AN7563_PMA_PLL_BR, 7));
+	an7563_update(priv->pma, AN7563_PMA_DA_CTRL_19,
+		      AN7563_PMA_PLL_BPA,
+		      FIELD_PREP(AN7563_PMA_PLL_BPA, 3));
+	an7563_update(priv->pma, AN7563_PMA_DA_CTRL_1,
+		      AN7563_PMA_PLL_BC,
+		      FIELD_PREP(AN7563_PMA_PLL_BC, 1));
+	an7563_update(priv->pma, AN7563_PMA_DA_CTRL_4,
+		      AN7563_PMA_PLL_FBKDIV,
+		      FIELD_PREP(AN7563_PMA_PLL_FBKDIV, 0x3e));
+	an7563_update(priv->pma, AN7563_PMA_SERDES_CTRL_10,
+		      AN7563_PMA_TX_POLARITY, 0);
+	an7563_update(priv->pma, AN7563_PMA_FREQ_CTRL_2,
+		      AN7563_PMA_HG_FREQ_MUX, 0);
+	an7563_update(priv->pma, AN7563_PMA_FREQ_CTRL_4,
+		      AN7563_PMA_HG_TX_FREQ_CNT | AN7563_PMA_HG_RX_FREQ_CNT,
+		      FIELD_PREP(AN7563_PMA_HG_TX_FREQ_CNT, 0x618) |
+		      FIELD_PREP(AN7563_PMA_HG_RX_FREQ_CNT, 0x618));
+
+	an7563_update(priv->pma, AN7563_PMA_SYS_CTRL_0,
+		      AN7563_PMA_SYS_CLK_MASK, AN7563_PMA_SYS_CLK_HSGMII);
+	an7563_update(priv->pma, AN7563_PMA_HG_RST_CTRL_0,
+		      AN7563_PMA_HG_RST_RELEASE, AN7563_PMA_HG_RST_RELEASE);
+	an7563_update(priv->pma, AN7563_PMA_DA_CTRL_2,
+		      AN7563_PMA_CDR_PI_PWD, AN7563_PMA_CDR_PI_PWD);
+	an7563_update(priv->pma, AN7563_PMA_RXFEDIG_CTRL_12,
+		      AN7563_PMA_EQ_REV,
+		      FIELD_PREP(AN7563_PMA_EQ_REV, 0x38));
+	an7563_update(priv->phya, AN7563_PHYA_CDR_CTRL,
+		      AN7563_PHYA_RX_DAC_PWD, 0);
+	an7563_update(priv->phya, AN7563_PHYA_XTAL_CTRL,
+		      AN7563_PHYA_XTAL_RESERVE_6, AN7563_PHYA_XTAL_RESERVE_6);
+	an7563_update(priv->pma, AN7563_PMA_OSR_SEL_CTRL,
+		      AN7563_PMA_OSR_MASK, AN7563_PMA_OSR_HSGMII);
+	an7563_update(priv->pma, AN7563_PMA_HG_MODE_CTRL_0,
+		      AN7563_PMA_HSGMII_MODE, AN7563_PMA_HSGMII_MODE);
+
+	an7563_update(priv->pma, AN7563_PMA_DA_CTRL_0,
+		      AN7563_PMA_PLL_FBKSEL, 0);
+	an7563_update(priv->pma, AN7563_PMA_LCPLL_NCPO,
+		      AN7563_PMA_LCPLL_NCPO_MASK,
+		      AN7563_PMA_LCPLL_NCPO_HSGMII);
+	an7563_update(priv->pma, AN7563_PMA_LCPLL_CHANGE,
+		      AN7563_PMA_LCPLL_CHANGE_EN, 0);
+	an7563_update(priv->pma, AN7563_PMA_LCPLL_LOAD,
+		      AN7563_PMA_LCPLL_LOAD_EN, AN7563_PMA_LCPLL_LOAD_EN);
+	an7563_update(priv->pma, AN7563_PMA_LCPLL_CHANGE,
+		      AN7563_PMA_LCPLL_CHANGE_EN, AN7563_PMA_LCPLL_CHANGE_EN);
+	an7563_update(priv->phya, AN7563_PHYA_PLL_SDM_CTRL,
+		      AN7563_PHYA_PLL_RESERVE_1, AN7563_PHYA_PLL_RESERVE_1);
+	an7563_update(priv->pma, AN7563_PMA_SERDES_CTRL_0,
+		      AN7563_PMA_PHYA_AUTO_INIT, AN7563_PMA_PHYA_AUTO_INIT);
+}
+
+static unsigned int an7563_pcs_inband_caps(struct phylink_pcs *pcs,
+					   phy_interface_t interface)
+{
+	return interface == PHY_INTERFACE_MODE_2500BASEX ?
+	       LINK_INBAND_DISABLE : 0;
+}
+
+static void an7563_pcs_pre_config(struct phylink_pcs *pcs,
+				  phy_interface_t interface)
+{
+	struct an7563_pcs *priv = pcs_to_an7563(pcs);
+	u32 stop = AIROHA_PCS_XFI_RXMPI_STOP | AIROHA_PCS_XFI_RXMBI_STOP |
+		   AIROHA_PCS_XFI_TXMPI_STOP | AIROHA_PCS_XFI_TXMBI_STOP;
+	u32 glb;
+	int err;
+
+	glb = readl(priv->mac + AIROHA_PCS_XFI_MAC_XFI_GIB_CFG);
+
+	err = reset_control_assert(priv->phy_rst);
+	if (!err)
+		err = reset_control_deassert(priv->phy_rst);
+	if (!err)
+		usleep_range(10000, 11000);
+	if (!err)
+		err = reset_control_assert(priv->mac_rst);
+	if (!err)
+		err = reset_control_deassert(priv->mac_rst);
+	if (!err)
+		err = regmap_update_bits(priv->scu, AN7563_SCU_RST_CFG,
+					 AN7563_SCU_XSI_RST,
+					 AN7563_SCU_XSI_RST);
+	if (!err)
+		err = regmap_update_bits(priv->scu, AN7563_SCU_RST_CFG,
+					 AN7563_SCU_XSI_RST, 0);
+	if (err) {
+		priv->pre_config_err = err;
+		dev_err(priv->dev, "failed to reset PON PCS: %d\n", err);
+		writel(glb, priv->mac + AIROHA_PCS_XFI_MAC_XFI_GIB_CFG);
+		return;
+	}
+
+	priv->pre_config_err =
+		regmap_update_bits(priv->scu, AN7563_SCU_WAN_CONF,
+				   AN7563_SCU_WAN_SEL,
+				   AN7563_SCU_WAN_SEL_HSGMII);
+	if (priv->pre_config_err) {
+		writel(glb, priv->mac + AIROHA_PCS_XFI_MAC_XFI_GIB_CFG);
+		return;
+	}
+
+	priv->pre_config_err =
+		regmap_update_bits(priv->scu, AN7563_SCU_SSTR,
+				   AN7563_SCU_PON_XSI_SEL,
+				   AN7563_SCU_PON_XSI_HSGMII);
+	if (priv->pre_config_err) {
+		writel(glb, priv->mac + AIROHA_PCS_XFI_MAC_XFI_GIB_CFG);
+		return;
+	}
+
+	writel(glb, priv->mac + AIROHA_PCS_XFI_MAC_XFI_GIB_CFG);
+	an7563_update(priv->mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG, stop, stop);
+	writel(0, priv->mac + AIROHA_PCS_XFI_MAC_XFI_LOGIC_RST);
+	writel(AIROHA_PCS_XFI_MAC_LOGIC_RST,
+	       priv->mac + AIROHA_PCS_XFI_MAC_XFI_LOGIC_RST);
+	usleep_range(1000, 2000);
+	writel(AIROHA_PCS_XFI_GLB_CNT_CLR,
+	       priv->mac + AIROHA_PCS_XFI_MAC_XFI_CNT_CLR);
+}
+
+static int an7563_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
+			     phy_interface_t interface,
+			     const unsigned long *advertising,
+			     bool permit_pause_to_mac)
+{
+	struct an7563_pcs *priv = pcs_to_an7563(pcs);
+	u32 rate_adapt;
+
+	if (interface != PHY_INTERFACE_MODE_2500BASEX ||
+	    neg_mode == PHYLINK_PCS_NEG_INBAND_ENABLED)
+		return -EINVAL;
+	if (priv->pre_config_err)
+		return priv->pre_config_err;
+
+	an7563_pcs_analog_init(priv);
+	an7563_update(priv->multi_sgmii,
+		      AIROHA_PCS_MULTI_SGMII_MSG_RX_CTRL_0,
+		      AIROHA_PCS_HSGMII_XFI_SEL, 0);
+	an7563_update(priv->hsgmii_pcs, AIROHA_PCS_HSGMII_PCS_CTROL_1,
+		      AIROHA_PCS_TBI_10B_MODE, 0);
+	an7563_update(priv->hsgmii_pcs,
+		      AIROHA_PCS_HSGMII_PCS_AN_SGMII_MODE_FORCE,
+		      AIROHA_PCS_HSGMII_PCS_FORCE_CUR_SGMII_MODE |
+		      AIROHA_PCS_HSGMII_PCS_FORCE_CUR_SGMII_MODE_SEL, 0);
+	an7563_update(priv->multi_sgmii,
+		      AIROHA_PCS_MULTI_SGMII_SGMII_STS_CTRL_0,
+		      AIROHA_PCS_FORCE_SPD_MODE_P0 | AIROHA_PCS_LINK_MODE_P0,
+		      AIROHA_PCS_FORCE_SPD_MODE_P0 |
+		      AIROHA_PCS_LINK_MODE_P0_2_5G);
+	an7563_update(priv->rate_adp, AIROHA_PCS_HSGMII_RATE_ADAPT_CTRL_11,
+		      AIROHA_PCS_HSGMII_RATE_ADPT_FORCE_RATE_ADAPT_MODE_EN |
+		      AIROHA_PCS_HSGMII_RATE_ADPT_FORCE_RATE_ADAPT_MODE, 0);
+	an7563_update(priv->an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_0,
+		      AIROHA_PCS_HSGMII_AN_SGMII_RA_ENABLE |
+		      AIROHA_PCS_HSGMII_AN_SGMII_RESET_PHY,
+		      AIROHA_PCS_HSGMII_AN_SGMII_RESET_PHY);
+	an7563_update(priv->hsgmii_pcs, AIROHA_PCS_HSGMII_PCS_CTROL_6,
+		      AIROHA_PCS_HSGMII_PCS_TX_ENABLE,
+		      AIROHA_PCS_HSGMII_PCS_TX_ENABLE);
+	an7563_update(priv->rate_adp, AIROHA_PCS_HSGMII_RATE_ADP_P0_CTRL_0,
+		      AIROHA_PCS_HSGMII_P0_DIS_MII_MODE, 0);
+
+	rate_adapt = AIROHA_PCS_HSGMII_RATE_ADAPT_TX_EN |
+		     AIROHA_PCS_HSGMII_RATE_ADAPT_RX_EN |
+		     AIROHA_PCS_HSGMII_RATE_ADAPT_TX_BYPASS |
+		     AIROHA_PCS_HSGMII_RATE_ADAPT_RX_BYPASS;
+	an7563_update(priv->rate_adp, AIROHA_PCS_HSGMII_RATE_ADAPT_CTRL_0,
+		      rate_adapt, rate_adapt);
+
+	return 0;
+}
+
+static int an7563_pcs_post_config(struct phylink_pcs *pcs,
+				  phy_interface_t interface)
+{
+	struct an7563_pcs *priv = pcs_to_an7563(pcs);
+	u32 mask = AIROHA_PCS_XFI_RX_FRAG_LEN | AIROHA_PCS_XFI_TX_FRAG_LEN |
+		   AIROHA_PCS_XFI_IPG_NUM | AIROHA_PCS_XFI_TX_FC_EN |
+		   AIROHA_PCS_XFI_RX_FC_EN;
+	u32 val = FIELD_PREP(AIROHA_PCS_XFI_RX_FRAG_LEN, 31) |
+		  FIELD_PREP(AIROHA_PCS_XFI_TX_FRAG_LEN, 31) |
+		  FIELD_PREP(AIROHA_PCS_XFI_IPG_NUM, 10) |
+		  AIROHA_PCS_XFI_TX_FC_EN | AIROHA_PCS_XFI_RX_FC_EN;
+
+	an7563_update(priv->mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG, mask, val);
+	return 0;
+}
+
+static void an7563_pcs_get_state(struct phylink_pcs *pcs, unsigned int neg_mode,
+				 struct phylink_link_state *state)
+{
+	struct an7563_pcs *priv = pcs_to_an7563(pcs);
+	u32 status = readl(priv->hsgmii_pcs + AN7563_PCS_STATE_2);
+
+	state->link = !!(status & AN7563_PCS_RX_SYNC);
+	state->an_complete = !!(status & AN7563_PCS_AN_DONE);
+	state->speed = SPEED_2500;
+	state->duplex = DUPLEX_FULL;
+}
+
+static void an7563_pcs_link_up(struct phylink_pcs *pcs, unsigned int neg_mode,
+			       phy_interface_t interface, int speed, int duplex)
+{
+	struct an7563_pcs *priv = pcs_to_an7563(pcs);
+	u32 stop = AIROHA_PCS_XFI_RXMPI_STOP | AIROHA_PCS_XFI_RXMBI_STOP |
+		   AIROHA_PCS_XFI_TXMPI_STOP | AIROHA_PCS_XFI_TXMBI_STOP;
+
+	an7563_update(priv->mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG, stop, 0);
+}
+
+static void an7563_pcs_link_down(struct phylink_pcs *pcs)
+{
+	struct an7563_pcs *priv = pcs_to_an7563(pcs);
+	u32 stop = AIROHA_PCS_XFI_RXMPI_STOP | AIROHA_PCS_XFI_RXMBI_STOP |
+		   AIROHA_PCS_XFI_TXMPI_STOP | AIROHA_PCS_XFI_TXMBI_STOP;
+
+	an7563_update(priv->mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG, stop, stop);
+}
+
+static const struct phylink_pcs_ops an7563_pcs_ops = {
+	.pcs_inband_caps = an7563_pcs_inband_caps,
+	.pcs_pre_config = an7563_pcs_pre_config,
+	.pcs_config = an7563_pcs_config,
+	.pcs_post_config = an7563_pcs_post_config,
+	.pcs_get_state = an7563_pcs_get_state,
+	.pcs_link_up = an7563_pcs_link_up,
+	.pcs_link_down = an7563_pcs_link_down,
+};
+
+static int an7563_pcs_probe(struct platform_device *pdev)
+{
+	static const char * const reg_names[] = {
+		"mac", "an", "pcs", "multi", "rate", "phya", "pma",
+	};
+	struct fwnode_pcs_provider *provider;
+	struct device *dev = &pdev->dev;
+	struct an7563_pcs *priv;
+	void __iomem **bases[ARRAY_SIZE(reg_names)];
+	unsigned int i;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = dev;
+	bases[0] = &priv->mac;
+	bases[1] = &priv->an;
+	bases[2] = &priv->hsgmii_pcs;
+	bases[3] = &priv->multi_sgmii;
+	bases[4] = &priv->rate_adp;
+	bases[5] = &priv->phya;
+	bases[6] = &priv->pma;
+	for (i = 0; i < ARRAY_SIZE(reg_names); i++) {
+		*bases[i] =
+			devm_platform_ioremap_resource_byname(pdev, reg_names[i]);
+		if (IS_ERR(*bases[i]))
+			return PTR_ERR(*bases[i]);
+	}
+
+	priv->scu = syscon_regmap_lookup_by_phandle(dev->of_node, "airoha,scu");
+	if (IS_ERR(priv->scu))
+		return PTR_ERR(priv->scu);
+
+	priv->mac_rst = devm_reset_control_get_exclusive(dev, "mac");
+	if (IS_ERR(priv->mac_rst))
+		return dev_err_probe(dev, PTR_ERR(priv->mac_rst),
+				     "failed to get MAC reset\n");
+	priv->phy_rst = devm_reset_control_get_exclusive(dev, "phy");
+	if (IS_ERR(priv->phy_rst))
+		return dev_err_probe(dev, PTR_ERR(priv->phy_rst),
+				     "failed to get PHY reset\n");
+
+	priv->pcs.ops = &an7563_pcs_ops;
+	priv->pcs.poll = true;
+	__set_bit(PHY_INTERFACE_MODE_2500BASEX,
+		  priv->pcs.supported_interfaces);
+	provider = devm_fwnode_pcs_add_provider(dev, dev_fwnode(dev),
+						fwnode_pcs_simple_xlate,
+						&priv->pcs);
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static const struct of_device_id an7563_pcs_match[] = {
+	{ .compatible = "airoha,an7563-pcs-pon" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, an7563_pcs_match);
+
+static struct platform_driver an7563_pcs_driver = {
+	.probe = an7563_pcs_probe,
+	.driver = {
+		.name = "airoha-an7563-pcs",
+		.of_match_table = an7563_pcs_match,
+	},
+};
+module_platform_driver(an7563_pcs_driver);
+
+MODULE_DESCRIPTION("Airoha AN7563 PON HSGMII PCS");
+MODULE_LICENSE("GPL");
