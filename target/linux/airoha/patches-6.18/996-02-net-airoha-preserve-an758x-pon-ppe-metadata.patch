From: PTPT52.AI <ptpt52@gmail.com>
Subject: [PATCH] net: airoha: preserve AN758x PON bearer metadata in PPE flows

Use the same VLAN and P-bit classifier for software and PPE egress.
Reject ambiguous PCP mappings and serialize bearer changes with both TC
and atomic natflow installation. Invalidate both directions of natflow
connections as well as TC flows before replacing PON bearer mappings.
Release source-MAC references only after successful hardware removal,
and keep the previous mapping on failure.

Based on the PON PPE support by pbs05.
Signed-off-by: PTPT52.AI <ptpt52@gmail.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -9140,11 +9140,42 @@
 }
 EXPORT_SYMBOL_GPL(airoha_eth_pon_xmit_control);
 
+static int airoha_eth_pon_commit_config(struct airoha_gdm_dev *dev,
+				      struct airoha_pon_flow_table *table,
+				      u32 qdma_tag)
+{
+	struct airoha_pon_flow_table *old;
+	struct airoha_ppe *ppe = dev->eth->ppe;
+	int err;
+
+	/* Also exclude natflow installation from the atomic packet path. */
+	mutex_lock(&flow_offload_mutex);
+	if (ppe)
+		spin_lock_bh(&ppe->natflow_lock);
+	err = airoha_ppe_remove_egress_flows(dev);
+	if (err) {
+		if (ppe)
+			spin_unlock_bh(&ppe->natflow_lock);
+		mutex_unlock(&flow_offload_mutex);
+		kfree(table);
+		return err;
+	}
+	old = rcu_replace_pointer(dev->pon_flow_table, table,
+				  lockdep_is_held(&flow_offload_mutex));
+	WRITE_ONCE(dev->pon_qdma_tag, qdma_tag);
+	if (ppe)
+		spin_unlock_bh(&ppe->natflow_lock);
+	mutex_unlock(&flow_offload_mutex);
+	synchronize_net();
+	kfree(old);
+	return 0;
+}
