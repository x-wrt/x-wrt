+	if (!chan)
+		goto out;
+
+	ret = -EOPNOTSUPP;
+	if (!chan->ops->flow_offload_check)
+		goto out;
+
+	ret = chan->ops->flow_offload_check(chan, path);
+out:
+	rcu_read_unlock();
+	return ret;
+}
