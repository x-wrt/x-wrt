+static struct net_device *
+airoha_ppe_natflow_output_dev(const flow_offload_hw_path_t *path)
+{
+	struct net_device *dev = path->dev;
+
+	/* Natflow preserves the DSA port in the final path, but replaces the
+	 * user device with its conduit and does not carry the DSA flag forward.
+	 */
+	if (path->dsa_port == 0xffff)
+		return dev;
+
+#if IS_ENABLED(CONFIG_NET_DSA)
+	{
+		struct dsa_port *cpu_dp = dev->dsa_ptr;
+		struct dsa_port *dp;
+
+		if (!cpu_dp || !cpu_dp->tag_ops ||
+		    cpu_dp->tag_ops->proto != DSA_TAG_PROTO_MTK)
+			return ERR_PTR(-EOPNOTSUPP);
+
+		dsa_tree_for_each_user_port(dp, cpu_dp->dst) {
+			if (dp->cpu_dp == cpu_dp && dp->index == path->dsa_port &&
+			    dp->user)
+				return dp->user;
+		}
+	}
+#endif
+
+	return ERR_PTR(-ENODEV);
+}
+
+static struct airoha_qdma *
+airoha_ppe_natflow_output_qdma(struct airoha_ppe *ppe,
+			       struct net_device *netdev)
+{
+	struct airoha_gdm_common *gdm;
+	struct airoha_gdm_dev *dev;
+
+	airoha_get_dsa_port(&netdev);
+	gdm = airoha_gdm_common_from_netdev(netdev);
+	if (!gdm || gdm->family != AIROHA_ETH_FAMILY_AIROHA)
+		return NULL;
+
+	dev = gdm->priv;
+	if (!dev || dev->eth != ppe->common.eth)
+		return NULL;
+
+	return &ppe->common.eth->qdma[!airoha_is_lan_gdm_dev(dev)];
+}
+
+static u16
+airoha_ppe_natflow_hw_hash(struct airoha_ppe *ppe,
+			  const flow_offload_hw_path_t *src, u16 hash)
+{
+	struct net_device *idev = airoha_ppe_natflow_output_dev(src);
+	struct airoha_qdma *qdma;
+
+	if (IS_ERR(idev))
+		return hash;
+	qdma = airoha_ppe_natflow_output_qdma(ppe, idev);
+	if (ppe->common.eth->soc->num_ppe > 1 &&
+	    qdma == &ppe->common.eth->qdma[1])
+		hash += airoha_ppe_natflow_num_entries(ppe);
+
+	return hash;
+}
+
+static bool
+airoha_ppe_natflow_is_extdev(const flow_offload_hw_path_t *path)
+{
+	if (path->flags & FLOW_OFFLOAD_PATH_EXTDEV)
+		return true;
+
+	return path->dev->netdev_ops->ndo_flow_offload !=
+	       airoha_ppe_natflow_offload;
+}
+
+static int
+airoha_ppe_natflow_cpu_port(struct airoha_ppe *ppe,
+			    const flow_offload_hw_path_t *src)
+{
+	struct airoha_qdma *qdma;
+	struct net_device *idev;
+
+	idev = airoha_ppe_natflow_output_dev(src);
+	if (IS_ERR(idev))
+		return PTR_ERR(idev);
+
+	qdma = airoha_ppe_natflow_output_qdma(ppe, idev);
+	if (!qdma)
+		return -EOPNOTSUPP;
+
+	return qdma == &ppe->common.eth->qdma[0] ? FE_PSE_PORT_CDM1 :
+						       FE_PSE_PORT_CDM2;
+}
+
+static u32 *
+airoha_ppe_natflow_entry_ib2(struct airoha_foe_entry *entry)
+{
+	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, entry->ib1);
+
+	if (type == PPE_PKT_TYPE_BRIDGE)
+		return &entry->bridge.ib2;
+	if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T)
+		return &entry->ipv6.ib2;
+
+	return &entry->ipv4.ib2;
+}
