-			ppe->offload_setup_done = true;
+			dma_wmb();
+			WRITE_ONCE(ppe->offload_setup_done, true);
 			dev_info(eth->dev,
 				 "PPE offload setup completed (no NPU, CPU-direct)\n");
 		}
@@ -2289,6 +2441,834 @@ error_npu_put:
 	return err;
 }
 
+static bool airoha_ppe_natflow_ready(struct airoha_ppe *ppe)
+{
+	return READ_ONCE(ppe->offload_setup_done) ||
+	       rcu_access_pointer(ppe->common.eth->npu);
+}
+
+static struct net_device *
+airoha_ppe_natflow_output_dev(const flow_offload_hw_path_t *path)
+{
+	struct net_device *dev = path->dev;
+
+	/* Natflow preserves the DSA port in the final path, but replaces the
+	 * user device with its conduit and does not carry the DSA flag forward.
+	 */
+	if (path->dsa_port == 0xffff)
+		return dev;
+
+#if IS_ENABLED(CONFIG_NET_DSA)
+	{
+		struct dsa_port *cpu_dp = dev->dsa_ptr;
+		struct dsa_port *dp;
+
+		if (!cpu_dp || !cpu_dp->tag_ops ||
+		    cpu_dp->tag_ops->proto != DSA_TAG_PROTO_MTK)
+			return ERR_PTR(-EOPNOTSUPP);
+
+		dsa_tree_for_each_user_port(dp, cpu_dp->dst) {
+			if (dp->cpu_dp == cpu_dp && dp->index == path->dsa_port &&
+			    dp->user)
+				return dp->user;
+		}
+	}
+#endif
+
+	return ERR_PTR(-ENODEV);
+}
+
+static struct airoha_qdma *
+airoha_ppe_natflow_output_qdma(struct airoha_ppe *ppe,
+			       struct net_device *netdev)
+{
+	struct airoha_gdm_common *gdm;
+	struct airoha_gdm_dev *dev;
+
+	airoha_get_dsa_port(&netdev);
+	gdm = airoha_gdm_common_from_netdev(netdev);
+	if (!gdm || gdm->family != AIROHA_ETH_FAMILY_AIROHA)
+		return NULL;
+
+	dev = gdm->priv;
+	if (!dev || dev->eth != ppe->common.eth)
+		return NULL;
+
+	return &ppe->common.eth->qdma[!airoha_is_lan_gdm_dev(dev)];
+}
+
+static bool
+airoha_ppe_natflow_is_extdev(const flow_offload_hw_path_t *path)
+{
+	if (path->flags & FLOW_OFFLOAD_PATH_EXTDEV)
+		return true;
+
+	return path->dev->netdev_ops->ndo_flow_offload !=
+	       airoha_ppe_natflow_offload;
+}
+
+static int
+airoha_ppe_natflow_cpu_port(struct airoha_ppe *ppe,
+			    const flow_offload_hw_path_t *src)
+{
+	struct airoha_qdma *qdma;
+	struct net_device *idev;
+
+	idev = airoha_ppe_natflow_output_dev(src);
+	if (IS_ERR(idev))
+		return PTR_ERR(idev);
+
+	qdma = airoha_ppe_natflow_output_qdma(ppe, idev);
+	if (!qdma)
+		return -EOPNOTSUPP;
+
+	return qdma == &ppe->common.eth->qdma[0] ? FE_PSE_PORT_CDM1 :
+						       FE_PSE_PORT_CDM2;
+}
+
+static u32 *
+airoha_ppe_natflow_entry_ib2(struct airoha_foe_entry *entry)
+{
+	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, entry->ib1);
+
+	if (type == PPE_PKT_TYPE_BRIDGE)
+		return &entry->bridge.ib2;
+	if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T)
+		return &entry->ipv6.ib2;
+
+	return &entry->ipv4.ib2;
+}
+
+static int
+airoha_ppe_natflow_sdn_cmd(struct airoha_qdma *qdma, u8 acnt0,
+			   bool packets, bool write, u64 *counter)
+{
+	u32 param = acnt0;
+	u32 val;
+	int err;
+
+	if (packets)
+		param |= AN7563_QDMA_SDN_CNTR_PACKET;
+	if (write) {
+		airoha_qdma_wr(qdma, AN7563_QDMA_SDN_CNTR_DATA_LO, 0);
+		airoha_qdma_wr(qdma, AN7563_QDMA_SDN_CNTR_DATA_HI, 0);
+		param |= AN7563_QDMA_SDN_CNTR_WRITE;
+	}
+
+	airoha_qdma_wr(qdma, AN7563_QDMA_SDN_CNTR_PARAM, param);
+	err = read_poll_timeout_atomic(airoha_qdma_rr, val,
+				       val & AN7563_QDMA_SDN_CNTR_DONE,
+				       1, 100, false, qdma,
+				       AN7563_QDMA_SDN_CNTR_PARAM);
+	if (err || !counter)
+		return err;
+
+	val = airoha_qdma_rr(qdma, AN7563_QDMA_SDN_CNTR_DATA_LO);
+	*counter = val;
+	*counter |= (u64)airoha_qdma_rr(qdma,
+					AN7563_QDMA_SDN_CNTR_DATA_HI) << 32;
+
+	return 0;
+}
+
+static int
+airoha_ppe_natflow_qdma_id(struct airoha_ppe *ppe,
+			   struct airoha_qdma *qdma)
+{
+	int id = qdma - &ppe->common.eth->qdma[0];
+
+	return id >= 0 && id < AIROHA_MAX_NUM_QDMA ? id : -EINVAL;
+}
+
+static int
+airoha_ppe_natflow_acnt_clear(struct airoha_qdma *qdma, u8 acnt0)
+{
+	int err, err2;
+
+	err = airoha_ppe_natflow_sdn_cmd(qdma, acnt0, false, true, NULL);
+	err2 = airoha_ppe_natflow_sdn_cmd(qdma, acnt0, true, true, NULL);
+
+	return err ?: err2;
+}
+
+static bool
+airoha_ppe_natflow_entry_bind_expired(struct airoha_ppe *ppe,
+				      struct airoha_flow_table_entry *flow)
+{
+	struct airoha_foe_entry *hwe;
+	u32 age, ib1, state;
+	bool expired = false;
+
+	spin_lock_bh(&ppe_lock);
+	if (flow->hash == 0xffff) {
+		expired = true;
+		goto unlock;
+	}
+
+	hwe = airoha_ppe_foe_get_entry_locked(ppe, flow->hash);
+	if (!hwe) {
+		expired = true;
+		goto unlock;
+	}
+
+	ib1 = READ_ONCE(hwe->ib1);
+	state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, ib1);
+	if (state != AIROHA_FOE_STATE_BIND ||
+	    !airoha_ppe_foe_compare_entry(flow, hwe)) {
+		expired = true;
+		goto unlock;
+	}
+
+	age = ib1 & AIROHA_FOE_IB1_BIND_UDP ? AN7563_PPE_BIND_AGE_UDP :
+						  AN7563_PPE_BIND_AGE_TCP;
+	if (airoha_ppe_get_entry_idle_time(ppe, ib1) >= age)
+		expired = true;
+unlock:
+	spin_unlock_bh(&ppe_lock);
+
+	return expired;
+}
+
+static bool
+airoha_ppe_natflow_acnt_reclaim_locked(struct airoha_ppe *ppe,
+				       struct airoha_qdma *qdma)
+{
+	struct airoha_natflow_entry *natflow, *tmp;
+	int dir;
+
+	lockdep_assert_held(&ppe->natflow_lock);
+
+	list_for_each_entry_safe(natflow, tmp, &ppe->natflow_flows, list) {
+		for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+			if (natflow->qdma[dir] != qdma ||
+			    natflow->acnt0[dir] == AN7563_PPE_ACNT0_DISABLED)
+				continue;
+			if (!airoha_ppe_natflow_entry_bind_expired(ppe, &natflow->flow[dir]))
+				continue;
+
+			if (natflow->committed & BIT(dir)) {
+				airoha_ppe_foe_flow_remove_entry(ppe, &natflow->flow[dir]);
+				natflow->committed &= ~BIT(dir);
+			}
+			if (ppe->natflow_hash[natflow->hash[dir]] == natflow)
+				ppe->natflow_hash[natflow->hash[dir]] = NULL;
+			airoha_ppe_natflow_acnt_release_locked(ppe, natflow, dir);
+			if (!natflow->committed)
+				airoha_ppe_natflow_remove_locked(ppe, natflow);
+			return true;
+		}
+	}
+
+	return false;
+}
+
+static void
+airoha_ppe_natflow_acnt_alloc_locked(struct airoha_ppe *ppe,
+				     struct airoha_natflow_entry *natflow,
+				     int dir)
+{
+	struct airoha_qdma *qdma = natflow->qdma[dir];
+	unsigned long acnt0;
+	u32 *ib2;
+	int qdma_id;
+
+	lockdep_assert_held(&ppe->natflow_lock);
+
+	if (!qdma)
+		return;
+
+	qdma_id = airoha_ppe_natflow_qdma_id(ppe, qdma);
+	if (qdma_id < 0)
+		return;
+
+retry:
+	acnt0 = find_first_zero_bit(ppe->natflow_acnt0[qdma_id],
+				    AN7563_PPE_ACNT0_ENTRIES);
+	if (acnt0 >= AN7563_PPE_ACNT0_ENTRIES) {
+		if (!airoha_ppe_natflow_acnt_reclaim_locked(ppe, qdma))
+			return;
+		goto retry;
+	}
+
+	__set_bit(acnt0, ppe->natflow_acnt0[qdma_id]);
+	if (airoha_ppe_natflow_acnt_clear(qdma, acnt0)) {
+		__clear_bit(acnt0, ppe->natflow_acnt0[qdma_id]);
+		dev_warn_ratelimited(ppe->common.eth->dev,
+				     "failed to clear QDMA%d ACNT0 %lu\n",
+				     qdma_id, acnt0);
+		return;
+	}
+
+	natflow->acnt0[dir] = acnt0;
+	ib2 = airoha_ppe_natflow_entry_ib2(&natflow->flow[dir].data);
+	*ib2 &= ~AIROHA_FOE_IB2_PORT_AG;
+	*ib2 |= FIELD_PREP(AIROHA_FOE_IB2_PORT_AG,
+			   AN7563_PPE_PORT_AG(acnt0));
+}
+
+static void
+airoha_ppe_natflow_acnt_release_locked(struct airoha_ppe *ppe,
+				       struct airoha_natflow_entry *natflow,
+				       int dir)
+{
+	struct airoha_qdma *qdma = natflow->qdma[dir];
+	u8 acnt0 = natflow->acnt0[dir];
+	int qdma_id;
+
+	lockdep_assert_held(&ppe->natflow_lock);
+
+	if (!qdma || acnt0 == AN7563_PPE_ACNT0_DISABLED)
+		return;
+
+	qdma_id = airoha_ppe_natflow_qdma_id(ppe, qdma);
+	if (qdma_id >= 0) {
+		if (airoha_ppe_natflow_acnt_clear(qdma, acnt0))
+			dev_warn_ratelimited(ppe->common.eth->dev,
+					     "failed to clear QDMA%d ACNT0 %u\n",
+					     qdma_id, acnt0);
+		__clear_bit(acnt0, ppe->natflow_acnt0[qdma_id]);
+	}
+
+	natflow->acnt0[dir] = AN7563_PPE_ACNT0_DISABLED;
+}
+
+static int
+airoha_ppe_natflow_acnt_read_locked(struct airoha_ppe *ppe,
+				    struct airoha_natflow_entry *natflow,
+				    int dir, u64 *bytes, u64 *packets)
+{
+	struct airoha_qdma *qdma = natflow->qdma[dir];
+	u64 raw_bytes, total_bytes, total_packets, overhead;
+	u8 acnt0 = natflow->acnt0[dir];
+	int err;
+
+	lockdep_assert_held(&ppe->natflow_lock);
+
+	if (!qdma || acnt0 == AN7563_PPE_ACNT0_DISABLED)
+		return -ENODATA;
+
+	err = airoha_ppe_natflow_sdn_cmd(qdma, acnt0, true, false,
+					 &total_packets);
+	if (err)
+		return err;
+
+	err = airoha_ppe_natflow_sdn_cmd(qdma, acnt0, false, false,
+					 &raw_bytes);
+	if (err)
+		return err;
+
+	overhead = total_packets * 20;
+	total_bytes = raw_bytes >= overhead ? raw_bytes - overhead : 0;
+	*packets = total_packets >= natflow->packets[dir] ?
+		   total_packets - natflow->packets[dir] : total_packets;
+	*bytes = total_bytes >= natflow->bytes[dir] ?
+		 total_bytes - natflow->bytes[dir] : total_bytes;
+	natflow->packets[dir] = total_packets;
+	natflow->bytes[dir] = total_bytes;
+
+	return 0;
+}
+
+static int
+airoha_ppe_natflow_prepare(struct airoha_ppe *ppe,
+			   struct airoha_foe_entry *entry,
+			   const flow_offload_tuple_t *tuple,
+			   const flow_offload_tuple_t *reply,
+			   const flow_offload_hw_path_t *src,
+			   const flow_offload_hw_path_t *dest,
+			   struct airoha_qdma **qdma, bool *extdev)
+{
+	struct airoha_flow_data data = {};
+	struct net_device *odev;
+	int cpu_port = -EINVAL, err, type;
+
+	if (!(dest->flags & FLOW_OFFLOAD_PATH_ETHERNET) ||
+	    dest->flags & (FLOW_OFFLOAD_PATH_STOP | FLOW_OFFLOAD_PATH_DEL))
+		return -EOPNOTSUPP;
+
+	*extdev = airoha_ppe_natflow_is_extdev(dest);
+	if (*extdev) {
+		cpu_port = airoha_ppe_natflow_cpu_port(ppe, src);
+		if (cpu_port < 0)
+			return cpu_port;
+		odev = NULL;
+		*qdma = NULL;
+	} else {
+		odev = airoha_ppe_natflow_output_dev(dest);
+		if (IS_ERR(odev))
+			return PTR_ERR(odev);
+		*qdma = airoha_ppe_natflow_output_qdma(ppe, odev);
+	}
+
+	if (!is_valid_ether_addr(dest->eth_src) ||
+	    !is_valid_ether_addr(dest->eth_dest))
+		return -EINVAL;
+
+	memcpy(data.eth.h_source, dest->eth_src, ETH_ALEN);
+	memcpy(data.eth.h_dest, dest->eth_dest, ETH_ALEN);
+	if (dest->flags & FLOW_OFFLOAD_PATH_VLAN) {
+		if (dest->vlan_proto != htons(ETH_P_8021Q) ||
+		    dest->vlan_id > VLAN_VID_MASK)
+			return -EOPNOTSUPP;
+		data.vlan.hdr[0].id = dest->vlan_id;
+		data.vlan.hdr[0].proto = dest->vlan_proto;
+		data.vlan.num = 1;
+	}
+	if (dest->flags & FLOW_OFFLOAD_PATH_PPPOE) {
+		data.pppoe.sid = dest->pppoe_sid;
+		data.pppoe.num = 1;
+	}
+
+	switch (tuple->l3proto) {
+	case AF_INET:
+		type = PPE_PKT_TYPE_IPV4_HNAPT;
+		break;
+	case AF_INET6:
+		type = PPE_PKT_TYPE_IPV6_ROUTE_5T;
+		break;
+	default:
+		return -EAFNOSUPPORT;
+	}
+
+	err = airoha_ppe_foe_entry_prepare(ppe->common.eth, entry, odev, type,
+					   &data, tuple->l4proto, 0);
+	if (err)
+		return err;
+	if (*extdev) {
+		u32 *ib2 = airoha_ppe_natflow_entry_ib2(entry);
+
+		*ib2 &= ~(AIROHA_FOE_IB2_NBQ | AIROHA_FOE_IB2_PSE_PORT |
+			  AIROHA_FOE_IB2_PSE_QOS | AIROHA_FOE_IB2_FAST_PATH);
+		*ib2 |= FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT, cpu_port);
+	}
+
+	entry->ib1 |= AIROHA_FOE_IB1_BIND_KEEPALIVE;
+	if (dest->flags & FLOW_OFFLOAD_PATH_BRIDGE)
+		entry->ib1 &= ~AIROHA_FOE_IB1_BIND_TTL;
+
+	if (tuple->l3proto == AF_INET) {
+		data.v4.src_addr = tuple->src_v4.s_addr;
+		data.v4.dst_addr = tuple->dst_v4.s_addr;
+		data.src_port = tuple->src_port;
+		data.dst_port = tuple->dst_port;
+		err = airoha_ppe_foe_entry_set_ipv4_tuple(entry, &data, false);
+		if (err)
+			return err;
+
+		data.v4.src_addr = reply->dst_v4.s_addr;
+		data.v4.dst_addr = reply->src_v4.s_addr;
+		data.src_port = reply->dst_port;
+		data.dst_port = reply->src_port;
+		err = airoha_ppe_foe_entry_set_ipv4_tuple(entry, &data, true);
+	} else {
+		data.v6.src_addr = tuple->src_v6;
+		data.v6.dst_addr = tuple->dst_v6;
+		data.src_port = tuple->src_port;
+		data.dst_port = tuple->dst_port;
+		err = airoha_ppe_foe_entry_set_ipv6_tuple(entry, &data);
+	}
+
+	return err;
+}
+
+static u32
+airoha_ppe_natflow_hash(const struct airoha_foe_entry *entry)
+{
+	u32 hash, hv1, hv2, hv3;
+	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, entry->ib1);
+
+	switch (type) {
+	case PPE_PKT_TYPE_IPV4_HNAPT:
+		hv1 = entry->ipv4.orig_tuple.ports;
+		hv2 = entry->ipv4.orig_tuple.dest_ip;
+		hv3 = entry->ipv4.orig_tuple.src_ip;
+		break;
+	case PPE_PKT_TYPE_IPV6_ROUTE_5T:
+		hv1 = entry->ipv6.src_ip[3] ^ entry->ipv6.dest_ip[3];
+		hv1 ^= entry->ipv6.ports;
+		hv2 = entry->ipv6.src_ip[2] ^ entry->ipv6.dest_ip[2];
+		hv2 ^= entry->ipv6.dest_ip[0];
+		hv3 = entry->ipv6.src_ip[1] ^ entry->ipv6.dest_ip[1];
+		hv3 ^= entry->ipv6.src_ip[0];
+		break;
+	default:
+		return U32_MAX;
+	}
+
+	/* AN7563 SRAM hash mode 1 uses the natflow tuple mixer, then folds
+	 * the 32-bit result into 128 four-way buckets.
+	 */
+	hash = (hv1 & hv2) | ((~hv1) & hv3);
+	hash = (hash >> 24) | (hash << 8);
+	hash ^= hv1 ^ hv2 ^ hv3;
+
+	return ((hash & 0x7f) ^
+		((hash >> 7) & 0x7f) ^
+		((hash >> 14) & 0x7f) ^
+		((hash >> 21) & 0x7f) ^
+		(hash >> 28)) << 2;
+}
+
+static int
+airoha_ppe_natflow_commit_entry(struct airoha_ppe *ppe,
+				struct airoha_flow_table_entry *flow,
+				u16 hash)
+{
+	struct airoha_foe_entry *hwe;
+	u32 state;
+	int err;
+
+	flow->type = FLOW_TYPE_L4;
+
+	spin_lock_bh(&ppe_lock);
+	if (!hlist_empty(&ppe->foe_flow[hash])) {
+		err = -EBUSY;
+		goto unlock;
+	}
+
+	hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
+	if (!hwe) {
+		err = -EIO;
+		goto unlock;
+	}
+
+	state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
+	if (state == AIROHA_FOE_STATE_BIND) {
+		err = -EBUSY;
+		goto unlock;
+	}
+
+	err = airoha_ppe_foe_commit_entry(ppe, &flow->data, hash, false);
+	if (!err) {
+		hlist_add_head(&flow->list, &ppe->foe_flow[hash]);
+		flow->hash = hash;
+		rcu_assign_pointer(ppe->natflow_foe[hash], flow);
+	}
+unlock:
+	spin_unlock_bh(&ppe_lock);
+
+	return err;
+}
+
+static void
+airoha_ppe_natflow_remove_locked(struct airoha_ppe *ppe,
+				 struct airoha_natflow_entry *natflow)
+{
+	int i;
+
+	lockdep_assert_held(&ppe->natflow_lock);
+
+	if (list_empty(&natflow->list))
+		return;
+
+	list_del_init(&natflow->list);
+	for (i = 0; i < FLOW_OFFLOAD_DIR_MAX; i++) {
+		if (ppe->natflow_hash[natflow->hash[i]] == natflow)
+			ppe->natflow_hash[natflow->hash[i]] = NULL;
+		if (natflow->committed & BIT(i))
+			airoha_ppe_foe_flow_remove_entry(ppe, &natflow->flow[i]);
+	}
+	for (i = 0; i < FLOW_OFFLOAD_DIR_MAX; i++)
+		airoha_ppe_natflow_acnt_release_locked(ppe, natflow, i);
+
+	kfree_rcu(natflow, rcu);
+}
+
+static void airoha_ppe_natflow_delete(struct airoha_ppe *ppe, u16 hash1,
+				      u16 hash2)
+{
+	struct airoha_natflow_entry *natflow;
+	u32 sram_entries = airoha_ppe_get_total_sram_num_entries(ppe);
+
+	if (!ppe->natflow_hash)
+		return;
+
+	spin_lock_bh(&ppe->natflow_lock);
+	natflow = hash1 < sram_entries ? ppe->natflow_hash[hash1] : NULL;
+	if (natflow)
+		airoha_ppe_natflow_remove_locked(ppe, natflow);
+	natflow = hash2 < sram_entries ? ppe->natflow_hash[hash2] : NULL;
+	if (natflow)
+		airoha_ppe_natflow_remove_locked(ppe, natflow);
+	spin_unlock_bh(&ppe->natflow_lock);
+}
+
+static int airoha_ppe_natflow_add(struct airoha_ppe *ppe,
+				  flow_offload_t *offload,
+				  flow_offload_hw_path_t *src,
+				  flow_offload_hw_path_t *dest)
+{
+	const flow_offload_tuple_t *orig, *reply;
+	struct airoha_natflow_entry *natflow;
+	struct airoha_natflow_entry *old;
+	struct airoha_foe_entry entry[FLOW_OFFLOAD_DIR_MAX];
+	struct airoha_qdma *qdma[FLOW_OFFLOAD_DIR_MAX];
+	bool extdev[FLOW_OFFLOAD_DIR_MAX];
+	u16 hash[FLOW_OFFLOAD_DIR_MAX];
+	u32 expected, sram_entries;
+	int err, i;
+
+	if (offload->flags || !offload->priv)
+		return -EINVAL;
+
+	orig = &offload->tuplehash[FLOW_OFFLOAD_DIR_ORIGINAL].tuple;
+	reply = &offload->tuplehash[FLOW_OFFLOAD_DIR_REPLY].tuple;
+	if (orig->l3proto != reply->l3proto ||
+	    orig->l4proto != reply->l4proto ||
+	    (orig->l4proto != IPPROTO_TCP && orig->l4proto != IPPROTO_UDP))
+		return -EINVAL;
+	if (orig->l3proto == AF_INET6 &&
+	    (!ipv6_addr_equal(&orig->src_v6, &reply->dst_v6) ||
+	     !ipv6_addr_equal(&orig->dst_v6, &reply->src_v6) ||
+	     orig->src_port != reply->dst_port ||
+	     orig->dst_port != reply->src_port))
+		return -EOPNOTSUPP;
+
+	err = airoha_ppe_natflow_prepare(ppe, &entry[FLOW_OFFLOAD_DIR_ORIGINAL],
+					 orig, reply, src, dest,
+					 &qdma[FLOW_OFFLOAD_DIR_ORIGINAL],
+					 &extdev[FLOW_OFFLOAD_DIR_ORIGINAL]);
+	if (err)
+		return err;
+	err = airoha_ppe_natflow_prepare(ppe, &entry[FLOW_OFFLOAD_DIR_REPLY],
+					 reply, orig, dest, src,
+					 &qdma[FLOW_OFFLOAD_DIR_REPLY],
+					 &extdev[FLOW_OFFLOAD_DIR_REPLY]);
+	if (err)
+		return err;
+
+	hash[FLOW_OFFLOAD_DIR_ORIGINAL] = offload->timeout >> 16;
+	hash[FLOW_OFFLOAD_DIR_REPLY] = offload->timeout;
+	sram_entries = airoha_ppe_get_total_sram_num_entries(ppe);
+	if (sram_entries != AN7563_PPE_SRAM_ENTRIES ||
+	    hash[FLOW_OFFLOAD_DIR_ORIGINAL] >= sram_entries ||
+	    hash[FLOW_OFFLOAD_DIR_REPLY] >= sram_entries ||
+	    hash[FLOW_OFFLOAD_DIR_ORIGINAL] == hash[FLOW_OFFLOAD_DIR_REPLY])
+		return -EINVAL;
+
+	for (i = 0; i < FLOW_OFFLOAD_DIR_MAX; i++) {
+		expected = airoha_ppe_natflow_hash(&entry[i]);
+		if ((hash[i] & ~(AN7563_PPE_SRAM_WAYS - 1)) != expected) {
+			dev_warn_ratelimited(ppe->common.eth->dev,
+					     "natflow hash mismatch: dir %d slot %#x expected bucket %#x\n",
+					     i, hash[i], expected);
+			return -EINVAL;
+		}
+	}
+
+	natflow = kzalloc(sizeof(*natflow), GFP_ATOMIC);
+	if (!natflow)
+		return -ENOMEM;
+
+	INIT_LIST_HEAD(&natflow->list);
+	for (i = 0; i < FLOW_OFFLOAD_DIR_MAX; i++) {
+		struct airoha_flow_table_entry *flow = &natflow->flow[i];
+
+		natflow->qdma[i] = qdma[i];
+		if (extdev[i])
+			natflow->extdev |= BIT(i);
+		natflow->acnt0[i] = AN7563_PPE_ACNT0_DISABLED;
+		natflow->hash[i] = hash[i];
+		flow->data = entry[i];
+		flow->hash = 0xffff;
+		flow->natflow = natflow;
+		flow->natflow_hash = hash[i];
+		INIT_HLIST_NODE(&flow->list);
+	}
+
+	rcu_assign_pointer(ppe->natflow_keepalive, offload->priv);
+
+	spin_lock_bh(&ppe->natflow_lock);
+	old = ppe->natflow_hash[hash[FLOW_OFFLOAD_DIR_ORIGINAL]];
+	if (old)
+		airoha_ppe_natflow_remove_locked(ppe, old);
+	old = ppe->natflow_hash[hash[FLOW_OFFLOAD_DIR_REPLY]];
+	if (old)
+		airoha_ppe_natflow_remove_locked(ppe, old);
+
+	for (i = 0; i < FLOW_OFFLOAD_DIR_MAX; i++) {
+		airoha_ppe_natflow_acnt_alloc_locked(ppe, natflow, i);
+		err = airoha_ppe_natflow_commit_entry(ppe, &natflow->flow[i],
+						      hash[i]);
+		if (err)
+			goto rollback;
+		natflow->committed |= BIT(i);
+	}
+
+	list_add_tail(&natflow->list, &ppe->natflow_flows);
+	for (i = 0; i < FLOW_OFFLOAD_DIR_MAX; i++)
+		ppe->natflow_hash[hash[i]] = natflow;
+	spin_unlock_bh(&ppe->natflow_lock);
+
+	return 0;
+
+rollback:
+	for (i = 0; i < FLOW_OFFLOAD_DIR_MAX; i++) {
+		if (natflow->committed & BIT(i))
+			airoha_ppe_foe_flow_remove_entry(ppe, &natflow->flow[i]);
+	}
+	for (i = 0; i < FLOW_OFFLOAD_DIR_MAX; i++)
+		airoha_ppe_natflow_acnt_release_locked(ppe, natflow, i);
+	spin_unlock_bh(&ppe->natflow_lock);
+	kfree_rcu(natflow, rcu);
+
+	return err;
+}
+
+int airoha_ppe_natflow_offload(flow_offload_type_t type,
+			       flow_offload_t *flow,
+			       flow_offload_hw_path_t *src,
+			       flow_offload_hw_path_t *dest)
+{
+	struct airoha_ppe *src_ppe = NULL, *dest_ppe = NULL;
+	struct airoha_ppe *ppe;
+
+	if (src->dev->netdev_ops->ndo_flow_offload ==
+	    airoha_ppe_natflow_offload)
+		src_ppe = airoha_ppe_from_netdev(src->dev);
+	if (dest->dev->netdev_ops->ndo_flow_offload ==
+	    airoha_ppe_natflow_offload)
+		dest_ppe = airoha_ppe_from_netdev(dest->dev);
+
+	ppe = src_ppe ?: dest_ppe;
+
+	if (!ppe || (src_ppe && dest_ppe && src_ppe != dest_ppe) ||
+	    !airoha_is(ppe->common.eth, airoha_an7563))
+		return -EOPNOTSUPP;
+
+	if (type == FLOW_OFFLOAD_DEL) {
+		airoha_ppe_natflow_delete(ppe, flow->timeout >> 16,
+					  flow->timeout);
+		return 0;
+	}
+	if (type != FLOW_OFFLOAD_ADD)
+		return -EOPNOTSUPP;
+
+	if (!airoha_ppe_natflow_ready(ppe))
+		return -EAGAIN;
+
+	return airoha_ppe_natflow_add(ppe, flow, src, dest);
+}
+
+int airoha_ppe_natflow_offload_check(flow_offload_hw_path_t *path)
+{
+	struct airoha_ppe *ppe;
+
+	if (!(path->flags & FLOW_OFFLOAD_PATH_ETHERNET))
+		return -EINVAL;
+
+	ppe = airoha_ppe_from_netdev(path->dev);
+	if (!ppe || !airoha_is(ppe->common.eth, airoha_an7563))
+		return -EOPNOTSUPP;
+
+	if (path->flags & FLOW_OFFLOAD_PATH_STOP) {
+		RCU_INIT_POINTER(ppe->natflow_keepalive, NULL);
+		synchronize_rcu();
+	} else if (path->flags & FLOW_OFFLOAD_PATH_DEL) {
+		airoha_ppe_natflow_delete(ppe, path->vlan_proto,
+					  path->vlan_id);
+	}
+
+	return 0;
+}
+
+bool airoha_ppe_natflow_rx(struct airoha_ppe *ppe, struct sk_buff *skb,
+			   u16 hash, u8 reason)
+{
+	struct airoha_flow_table_entry *flow;
+	struct airoha_natflow_entry *natflow;
+	airoha_natflow_keepalive_t keepalive;
+	bool force_cpu = reason == CRSN_22;
+	u64 bytes = 0, packets = 0;
+	u32 sw_idx;
+	int dir, err;
+
+	if (!ppe || (!force_cpu &&
+	    (reason < AN7563_PPE_CRSN_KEEPALIVE_MIN ||
+	     reason > AN7563_PPE_CRSN_KEEPALIVE_MAX)) || !ppe->natflow_foe)
+		return false;
+	if (airoha_ppe_hw_to_sw_idx(ppe, hash, &sw_idx))
+		return !force_cpu;
+
+	rcu_read_lock();
+	flow = rcu_dereference(ppe->natflow_foe[sw_idx]);
+	keepalive = rcu_dereference(ppe->natflow_keepalive);
+	if (!flow || !flow->natflow || !keepalive)
+		goto out;
+
+	natflow = flow->natflow;
+	if (flow == &natflow->flow[FLOW_OFFLOAD_DIR_ORIGINAL])
+		dir = FLOW_OFFLOAD_DIR_ORIGINAL;
+	else if (flow == &natflow->flow[FLOW_OFFLOAD_DIR_REPLY])
+		dir = FLOW_OFFLOAD_DIR_REPLY;
+	else
+		goto out;
+
+	spin_lock_bh(&ppe->natflow_lock);
+	if (rcu_access_pointer(ppe->natflow_foe[sw_idx]) != flow ||
+	    flow->hash != sw_idx || flow->natflow != natflow ||
+	    !(natflow->committed & BIT(dir)) || list_empty(&natflow->list)) {
+		spin_unlock_bh(&ppe->natflow_lock);
+		goto out;
+	}
+	if (force_cpu) {
+		bool extdev = natflow->extdev & BIT(dir);
+
+		spin_unlock_bh(&ppe->natflow_lock);
+		if (!extdev)
+			goto out;
+
+		skb_set_hash(skb, AN7563_NATFLOW_QUEUE_MAPPING_MAGIC |
+			     flow->natflow_hash, PKT_HASH_TYPE_L4);
+		skb->vlan_tci |= AN7563_NATFLOW_QUEUE_MAPPING_MAGIC;
+		skb->pkt_type = PACKET_HOST;
+		skb->protocol = eth_hdr(skb)->h_proto;
+		goto out;
+	}
+
+	err = airoha_ppe_natflow_acnt_read_locked(ppe, natflow, dir,
+						  &bytes, &packets);
+	spin_unlock_bh(&ppe->natflow_lock);
+	if (err && err != -ENODATA)
+		dev_warn_ratelimited(ppe->common.eth->dev,
+				     "failed to read natflow ACNT0 for hash %#x\n",
+				     flow->natflow_hash);
+
+	err = keepalive(flow->natflow_hash, (unsigned long)bytes,
+			(unsigned long)packets, NULL, NULL, 2, jiffies);
+	if (err) {
+		spin_lock_bh(&ppe->natflow_lock);
+		if (rcu_access_pointer(ppe->natflow_foe[sw_idx]) == flow &&
+		    flow->hash == sw_idx && flow->natflow == natflow &&
+		    !list_empty(&natflow->list))
+			airoha_ppe_natflow_remove_locked(ppe, natflow);
+		spin_unlock_bh(&ppe->natflow_lock);
+	}
+out:
+	rcu_read_unlock();
+
+	return !force_cpu;
+}
+
+static void airoha_ppe_natflow_flush(struct airoha_ppe *ppe)
+{
+	struct airoha_natflow_entry *natflow;
+
+	if (!ppe->natflow_hash)
+		return;
+
+	RCU_INIT_POINTER(ppe->natflow_keepalive, NULL);
+	synchronize_rcu();
+
+	spin_lock_bh(&ppe->natflow_lock);
+	while (!list_empty(&ppe->natflow_flows)) {
+		natflow = list_first_entry(&ppe->natflow_flows,
+					   struct airoha_natflow_entry, list);
+		airoha_ppe_natflow_remove_locked(ppe, natflow);
+	}
+	spin_unlock_bh(&ppe->natflow_lock);
+}
