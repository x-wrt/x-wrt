From: X-WRT <dev@x-wrt.com>
Date: Sun, 20 Sep 2026 00:00:00 +0800
Subject: [PATCH] PCI: mediatek: add AN7563 host controller setup

AN7563 uses the MediaTek Gen2 PCIe controller programming model, but its
root ports require a few SoC-specific settings which are absent from the
MT7622 setup path.

The AN7563 vendor driver programs the port as a root complex, uses the
native PCIe-to-AXI window encoding, clears a controller-specific interrupt
mask bit, and enables a coherency workaround explicitly documented for
AN7563 with Kite wireless devices.  Without these settings the link can
train and the MT7992 endpoint can enumerate, while the root-port BAR is
decoded incorrectly and mt7996 MCU commands time out.

Add a dedicated compatible and keep the common Gen2 startup sequence while
applying only the AN7563-specific register differences.

Signed-off-by: X-WRT <dev@x-wrt.com>
---
 drivers/pci/controller/pcie-mediatek.c | 34 +++++++++++++++++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

--- a/drivers/pci/controller/pcie-mediatek.c
+++ b/drivers/pci/controller/pcie-mediatek.c
@@ -82,8 +82,13 @@
 
 #define PCIE_INT_MASK		0x420
 #define INTX_MASK		GENMASK(19, 16)
+#define AN7563_INT_MASK_BIT13	BIT(13)
 #define INTX_SHIFT		16
 #define PCIE_INT_STATUS		0x424
+#define AN7563_PCIE_GBL		0x000
+#define AN7563_PCIE_RC_MODE	0x804201
+#define AN7563_PCIE_MMIO_CTRL	0x564
+#define AN7563_PCIE_COHERENT	BIT(0)
 #define MSI_STATUS		BIT(23)
 #define PCIE_IMSI_STATUS	0x42c
 #define PCIE_IMSI_ADDR		0x430
@@ -148,6 +152,7 @@ struct mtk_pcie_port;
 /**
  * struct mtk_pcie_soc - differentiate between host generations
  * @need_fix_class_id: whether this host's class ID needed to be fixed or not
+ * @is_an7563: whether the host requires AN7563-specific setup
  * @need_fix_device_id: whether this host's device ID needed to be fixed or not
  * @no_msi: Bridge has no MSI support, and relies on an external block
  * @device_id: device ID which this host need to be fixed
@@ -156,6 +161,7 @@ struct mtk_pcie_port;
  */
 struct mtk_pcie_soc {
 	bool need_fix_class_id;
+	bool is_an7563;
 	bool need_fix_device_id;
 	bool no_msi;
 	unsigned int device_id;
@@ -702,6 +708,11 @@ static int mtk_pcie_startup_port_v2(stru
 	       PCIE_MAC_SRSTB | PCIE_CRSTB;
 	writel(val, port->base + PCIE_RST_CTRL);
 
+	/* AN7563 requires the per-port block to be explicitly set to RC mode. */
+	if (soc->is_an7563)
+		writel(AN7563_PCIE_RC_MODE,
+		       port->base + AN7563_PCIE_GBL);
+
 	/* Set up vendor ID and class code */
 	if (soc->need_fix_class_id) {
 		val = PCI_VENDOR_ID_MEDIATEK;
@@ -724,6 +734,8 @@ static int mtk_pcie_startup_port_v2(stru
 	/* Set INTx mask */
 	val = readl(port->base + PCIE_INT_MASK);
 	val &= ~INTX_MASK;
+	if (soc->is_an7563)
+		val &= ~AN7563_INT_MASK_BIT13;
 	writel(val, port->base + PCIE_INT_MASK);
 
 	if (IS_ENABLED(CONFIG_PCI_MSI))
@@ -747,9 +759,18 @@ static int mtk_pcie_startup_port_v2(stru
 	writel(val, port->base + PCIE_AHB_TRANS_BASE0_H);
 
 	/* Set PCIe to AXI translation memory space.*/
-	val = PCIE2AHB_SIZE | WIN_ENABLE;
+	val = WIN_ENABLE;
+	if (!soc->is_an7563)
+		val |= PCIE2AHB_SIZE;
 	writel(val, port->base + PCIE_AXI_WINDOW0);
 
+	/* AN7563 requires coherent endpoint DMA for Kite wireless devices. */
+	if (soc->is_an7563) {
+		val = readl(port->base + AN7563_PCIE_MMIO_CTRL);
+		val |= AN7563_PCIE_COHERENT;
+		writel(val, port->base + AN7563_PCIE_MMIO_CTRL);
+	}
+
 	return 0;
 }
 
@@ -1228,6 +1248,14 @@ static const struct mtk_pcie_soc mtk_pci
 	.setup_irq = mtk_pcie_setup_irq,
 };
 
+static const struct mtk_pcie_soc mtk_pcie_soc_an7563 = {
+	.need_fix_class_id = true,
+	.is_an7563 = true,
+	.ops = &mtk_pcie_ops_v2,
+	.startup = mtk_pcie_startup_port_v2,
+	.setup_irq = mtk_pcie_setup_irq,
+};
+
 static const struct mtk_pcie_soc mtk_pcie_soc_mt7622 = {
 	.need_fix_class_id = true,
 	.ops = &mtk_pcie_ops_v2,
@@ -1247,6 +1275,7 @@ static const struct mtk_pcie_soc mtk_pci
 };
 
 static const struct of_device_id mtk_pcie_ids[] = {
+	{ .compatible = "airoha,an7563-pcie", .data = &mtk_pcie_soc_an7563 },
 	{ .compatible = "mediatek,mt2701-pcie", .data = &mtk_pcie_soc_v1 },
 	{ .compatible = "mediatek,mt7623-pcie", .data = &mtk_pcie_soc_v1 },
 	{ .compatible = "mediatek,mt2712-pcie", .data = &mtk_pcie_soc_mt2712 },
