From: X-WRT <dev@x-wrt.com>
Subject: [PATCH] net: phy: split Airoha GE PHY and add opt-in software calibration

Backport the Airoha GE PHY v5 series and its PHY package locking dependency
onto 6.18. Preserve the current AN7581 interrupt handling and keep shared
MediaTek LED helpers exported from the common library.

Fix recursive package locking and the TX offset cleanup lock typo. Hold the
package lock once for the entire config_init, separately lock the MDIO bus
for package accesses, always clear cycle triggers and propagate cycle errors.
Run REXT on port zero and validate the package port range before indexing
per-port tables. Reject calibration if port zero is missing or has a different
PHY ID.

Software calibration is explicitly opt-in and disabled by default: v5 still
assumes the AN7581 chip revision and board MDI resistor type. With it disabled,
retain bootloader calibration and the existing AN7583 power-up operation.

Upstream-author: Christian Marangi <ansuelsmth@gmail.com>
Link: https://lore.kernel.org/r/20261105105504.1024-1-ansuelsmth@gmail.com
Link: https://git.kernel.org/torvalds/c/ebb16fca011ce08fa710cec42ee43a33bf331893
Signed-off-by: X-WRT <dev@x-wrt.com>
---
diff --git a/drivers/net/phy/mediatek/Kconfig b/drivers/net/phy/mediatek/Kconfig
index bb7dc87..da4601f 100644
--- a/drivers/net/phy/mediatek/Kconfig
+++ b/drivers/net/phy/mediatek/Kconfig
@@ -1,4 +1,25 @@
 # SPDX-License-Identifier: GPL-2.0-only
+config AIROHA_GE_SOC_PHY
+	tristate "Airoha SoC Gigabit Ethernet PHYs"
+	depends on ARM64 || ECONET || COMPILE_TEST
+	depends on ARCH_AIROHA || ECONET || COMPILE_TEST
+	select MTK_NET_PHYLIB
+	select PHY_PACKAGE
+	help
+	  Supports Airoha SoC built-in Gigabit Ethernet PHYs.
+
+	  Include support for built-in Ethernet PHYs which are present in
+	  the AN7581 and AN7583 SoCs.
+
+config AIROHA_GE_SOC_PHY_CALIBRATION
+	bool "Experimental Airoha GE PHY software calibration"
+	depends on AIROHA_GE_SOC_PHY
+	help
+	  Recalibrate the AN7581/AN7583 analogue PHY during startup.
+	  The upstream v5 tables assume a chip revision and MDI resistor
+	  type. Enable only for board validation. Say N to keep the
+	  bootloader calibration and the existing power-up behavior.
+
 config MEDIATEK_2P5GE_PHY
 	tristate "MediaTek 2.5Gb Ethernet PHYs"
 	depends on (ARM64 && ARCH_MEDIATEK) || COMPILE_TEST
@@ -24,8 +45,7 @@ config MEDIATEK_GE_PHY
 config MEDIATEK_GE_SOC_PHY
 	tristate "MediaTek SoC Ethernet PHYs"
 	depends on ARM64 || COMPILE_TEST
-	depends on ARCH_AIROHA || (ARCH_MEDIATEK && NVMEM_MTK_EFUSE) || \
-		   COMPILE_TEST
+	depends on (ARCH_MEDIATEK && NVMEM_MTK_EFUSE) || COMPILE_TEST
 	select MTK_NET_PHYLIB
 	select PHY_PACKAGE
 	help
