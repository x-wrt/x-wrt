From: liujixings <liujixings@outlook.com>
Subject: [PATCH] net: airoha: preserve native AN7581 L2B ingress keys

Native L2B entries use a different layout from the software bridge
profile and IPv4 entries. Writing the template ib2 at offset 16 corrupts
the learned source MAC; the native forwarding control is at offset 44.

Keep the template and IPv4/IPv6 subflow paths unchanged. Add a distinct
native layout, preserve its learned key, and decode it consistently. Do
not redirect native entries through an unverified NPU stats layout.

Signed-off-by: liujixings <liujixings@outlook.com>
---
 drivers/net/ethernet/airoha/airoha_eth.h         | 27 +++++++++++++++++
 drivers/net/ethernet/airoha/airoha_ppe.c         | 30 +++++++++++++++++++
 drivers/net/ethernet/airoha/airoha_ppe_debugfs.c | 16 +++++++++-
 3 files changed, 72 insertions(+), 1 deletion(-)

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -632,6 +632,26 @@ struct airoha_foe_bridge {
 	struct airoha_foe_mac_info l2;
 };
 
+/* AN7581 native L2B hardware entry. Keep bridge as the software template. */
+struct airoha_foe_l2b {
+	u32 dest_mac_hi;
+	u16 ingress_vlan;
+	u16 dest_mac_lo;
+	u32 key;
+	u32 src_mac_hi;
+	u16 reserved0;
+	u16 src_mac_lo;
+	u32 reserved1[4];
+	u32 data;
+	u32 ib2;
+	u16 vlan1;
+	u16 etype;
+	u32 reserved2;
+	u16 vlan2;
+	u16 reserved3;
+	u32 reserved4;
+};
+
 struct airoha_foe_ipv4_tuple {
 	u32 src_ip;
 	u32 dest_ip;
@@ -706,6 +726,7 @@ struct airoha_foe_entry {
 			u32 ib1;
 			union {
 				struct airoha_foe_bridge bridge;
+				struct airoha_foe_l2b l2b;
 				struct airoha_foe_ipv4 ipv4;
 				struct airoha_foe_ipv4_dslite dslite;
 				struct airoha_foe_ipv6 ipv6;
@@ -717,6 +738,12 @@ struct airoha_foe_entry {
 	};
 };
 
+static_assert(offsetof(struct airoha_foe_entry, l2b.src_mac_hi) == 16);
+static_assert(offsetof(struct airoha_foe_entry, l2b.data) == 40);
+static_assert(offsetof(struct airoha_foe_entry, l2b.ib2) == 44);
+static_assert(offsetof(struct airoha_foe_entry, l2b.vlan1) == 48);
+static_assert(sizeof(struct airoha_foe_entry) == AIROHA_FOE_ENTRY_SIZE);
+
 static inline bool airoha_foe_v1_is_ipv6_5t(const struct airoha_foe_entry *entry)
 {
 	return FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, entry->ib1) ==
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -941,8 +941,15 @@ void airoha_ppe_foe_entry_get_stats(stru
 	struct airoha_eth *eth = ppe->common.eth;
 	int ppe_num_stats_entries;
 	struct airoha_npu *npu;
+	struct airoha_foe_entry *hwe;
 	u32 index;
 
+	hwe = ppe->common.foe + sw_idx * AIROHA_FOE_ENTRY_SIZE;
+	if (airoha_is(eth, airoha_en7581) &&
+	    FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE,
+		      READ_ONCE(hwe->ib1)) == PPE_PKT_TYPE_BRIDGE)
+		return;
+
 	ppe_num_stats_entries = airoha_ppe_get_total_num_stats_entries(ppe);
 	if (ppe_num_stats_entries <= 0)
 		return;
@@ -1004,6 +1011,11 @@ static void airoha_ppe_foe_flow_stats_up
 	int ppe_num_stats_entries;
 	u8 nbq;
 
+	/* No verified NPU counter layout for native AN7581 L2B entries. */
+	if (airoha_is(ppe->common.eth, airoha_en7581) &&
+	    type == PPE_PKT_TYPE_BRIDGE)
+		return;
+
 	ppe_num_stats_entries = airoha_ppe_get_total_num_stats_entries(ppe);
 	if (ppe_num_stats_entries < 0)
 		return;
@@ -1261,6 +1273,16 @@ airoha_ppe_foe_commit_subflow_entry(stru
 	hwe.ib1 = (hwe.ib1 & mask) | (e->data.ib1 & ~mask);
 
 	type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe.ib1);
+	if (airoha_is(ppe->common.eth, airoha_en7581) &&
+	    type == PPE_PKT_TYPE_BRIDGE) {
+		/* Preserve the hardware-learned ingress key and source MAC. */
+		hwe.l2b.data = e->data.bridge.data;
+		hwe.l2b.ib2 = e->data.bridge.ib2;
+		hwe.l2b.vlan1 = e->data.bridge.l2.common.vlan1;
+		hwe.l2b.vlan2 = e->data.bridge.l2.common.vlan2;
+		hwe.l2b.etype = e->data.bridge.l2.common.etype;
+		goto commit;
+	}
 	if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
 		memcpy(&hwe.ipv6.l2, &e->data.bridge.l2, sizeof(hwe.ipv6.l2));
 		hwe.ipv6.ib2 = e->data.bridge.ib2;
@@ -1276,6 +1298,7 @@ airoha_ppe_foe_commit_subflow_entry(stru
 	}
 
 	hwe.bridge.data = e->data.bridge.data;
+commit:
 	airoha_ppe_foe_commit_entry(ppe, &hwe, sw_idx, rx_wlan);
 
 	return 0;
@@ -1632,6 +1655,12 @@ static void airoha_ppe_foe_insert_entry(
 	if (state == AIROHA_FOE_STATE_BIND)
 		goto unlock;
 
+	/* Native L2B uses its learned key, not an IPv4/L4 hash bucket. */
+	if (airoha_is(ppe->common.eth, airoha_en7581) &&
+	    FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) ==
+	    PPE_PKT_TYPE_BRIDGE)
+		goto l2_lookup;
+
 	if (airoha_is(ppe->common.eth, airoha_en7523)) {
 		/* On EN7523 the offloaded flows live in ppe->pending_flows (the
 		 * SW hash does not match the HW hash), so they are matched by
@@ -1682,6 +1711,7 @@ static void airoha_ppe_foe_insert_entry(
 	if (commit_done)
 		goto unlock;
 
+l2_lookup:
 	airoha_ppe_foe_set_bridge_addrs(&br, eth_hdr(skb));
 	e = rhashtable_lookup_fast(&ppe->l2_flows, &br,
 				   airoha_l2_flow_table_params);
--- a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
@@ -120,6 +120,7 @@ static int airoha_ppe_debugfs_foe_json_s
 		const char *state_str, *type_str = "UNKNOWN";
 		void *src_addr = NULL, *dest_addr = NULL;
 		u16 *src_port = NULL, *dest_port = NULL;
+		struct airoha_foe_mac_info_common native_l2 = {};
 		struct airoha_foe_mac_info_common *l2;
 		unsigned char h_source[ETH_ALEN] = {};
 		struct airoha_foe_stats64 stats = {};
@@ -194,7 +195,20 @@ static int airoha_ppe_debugfs_foe_json_s
 			break;
 		}
 
-		if (type == PPE_PKT_TYPE_BRIDGE) {
+		if (airoha_is(ppe->common.eth, airoha_en7581) &&
+		    type == PPE_PKT_TYPE_BRIDGE) {
+			data = hwe->l2b.data;
+			ib2 = hwe->l2b.ib2;
+			native_l2.dest_mac_hi = hwe->l2b.dest_mac_hi;
+			native_l2.dest_mac_lo = hwe->l2b.dest_mac_lo;
+			native_l2.src_mac_hi = hwe->l2b.src_mac_hi;
+			native_l2.vlan1 = hwe->l2b.vlan1;
+			native_l2.vlan2 = hwe->l2b.vlan2;
+			native_l2.etype = hwe->l2b.etype;
+			l2 = &native_l2;
+			*((__be16 *)&h_source[4]) =
+				cpu_to_be16(hwe->l2b.src_mac_lo);
+		} else if (type == PPE_PKT_TYPE_BRIDGE) {
 			data = hwe->bridge.data;
 			ib2 = hwe->bridge.ib2;
 			l2 = &hwe->bridge.l2.common;
