+++ b/drivers/net/ethernet/zte/zx279133-offload-natflow.h
@@ -0,0 +1,378 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by zx279133-offload.c. */
+
+#define ZX279133_NATFLOW_MAX (ZX279133_FAST_STAT_DEPTH / 2)
+#define ZX279133_NATFLOW_IDLE (8 * HZ)
+
+struct zx279133_natflow_pair {
+	struct list_head list;
+	struct zte_nppt_natflow_request req;
+	struct zx279133_flow_offload *offload;
+	struct zte_nppt_natflow_stats final;
+	unsigned long cookie[2];
+	unsigned long lastused;
+	bool removing;
+};
+
+static DEFINE_SPINLOCK(zx279133_natflow_queue_lock);
+static DEFINE_MUTEX(zx279133_natflow_lock);
+static LIST_HEAD(zx279133_natflow_pending);
+static LIST_HEAD(zx279133_natflow_pairs);
+static struct zx279133_flow_offload *zx279133_natflow_engine;
+static unsigned int zx279133_natflow_count;
+static bool zx279133_natflow_flushing;
+static void zx279133_natflow_poll(struct work_struct *work);
+static DECLARE_DELAYED_WORK(zx279133_natflow_work, zx279133_natflow_poll);
+
+static void zx279133_natflow_attach(struct zx279133_flow_offload *offload)
+{
+	spin_lock_bh(&zx279133_natflow_queue_lock);
+	if (!zx279133_natflow_engine)
+		zx279133_natflow_engine = offload;
+	spin_unlock_bh(&zx279133_natflow_queue_lock);
+}
+
+static void zx279133_natflow_detach(struct zx279133_flow_offload *offload)
+{
+	spin_lock_bh(&zx279133_natflow_queue_lock);
+	if (zx279133_natflow_engine == offload)
+		zx279133_natflow_engine = NULL;
+	spin_unlock_bh(&zx279133_natflow_queue_lock);
+}
+
+static int zte_nppt_natflow_submit(const struct zte_nppt_natflow_request *req)
+{
+	struct zx279133_natflow_pair *pair;
+	int ret = 0;
+
+	if (!req || !req->notify || !req->dev[0] || !req->dev[1] ||
+	    req->dev[0] == req->dev[1] ||
+	    (req->tuple[0].proto != IPPROTO_TCP && req->tuple[0].proto != IPPROTO_UDP) ||
+	    req->tuple[0].proto != req->tuple[1].proto)
+		return -EINVAL;
+
+	pair = kzalloc_obj(*pair, GFP_ATOMIC);
+	if (!pair)
+		return -ENOMEM;
+	pair->req = *req;
+
+	spin_lock_bh(&zx279133_natflow_queue_lock);
+	if (!zx279133_natflow_engine || zx279133_natflow_flushing) {
+		ret = -EAGAIN;
+	} else if (zx279133_natflow_count == ZX279133_NATFLOW_MAX) {
+		ret = -ENOSPC;
+	} else {
+		pair->offload = zx279133_natflow_engine;
+		kref_get(&pair->offload->ref);
+		dev_hold(req->dev[0]);
+		dev_hold(req->dev[1]);
+		zx279133_natflow_count++;
+		list_add_tail(&pair->list, &zx279133_natflow_pending);
+		queue_delayed_work(system_unbound_wq, &zx279133_natflow_work, 0);
+	}
+	spin_unlock_bh(&zx279133_natflow_queue_lock);
+	if (ret)
+		kfree(pair);
+	return ret;
+}
+
+static int zx279133_natflow_notify(struct zx279133_natflow_pair *pair,
+				   enum zte_nppt_natflow_event event,
+				   const struct zte_nppt_natflow_stats *stats)
+{
+	int ret;
+
+	local_bh_disable();
+	rcu_read_lock();
+	ret = pair->req.notify(pair->req.context, event, stats);
+	rcu_read_unlock();
+	local_bh_enable();
+	return ret;
+}
+
+static void zx279133_natflow_rollback(struct zx279133_natflow_pair *pair)
+{
+	int d;
+
+	for (d = 0; d < 2; d++) {
+		struct zx279133_flow_counters stats = {};
+		int ret;
+
+		if (!pair->cookie[d])
+			continue;
+		ret = zx279133_flow_destroy(pair->offload, pair->cookie[d], &stats);
+		if (!ret || ret == -ENOENT)
+			pair->cookie[d] = 0;
+		pair->final.bytes[d] += stats.bytes;
+		pair->final.packets[d] += stats.packets;
+	}
+}
+
+static int zx279133_natflow_vlan(struct zx279133_flow_offload *offload,
+				 struct zx279133_flow_spec *spec, u16 from, u16 to)
+{
+	struct zx279133_vlan_plan *vlan = &spec->data.vlan;
+
+	if (!from && !to)
+		return 0;
+	if (!zx279133_vlan_enabled(offload->np) ||
+	    from >= VLAN_VID_MASK || to >= VLAN_VID_MASK ||
+	    (from && spec->ingress == ZX279133_FLOW_PORT_WAN &&
+	     !zx279133_wan_vlan_enabled(offload->np)))
+		return -EOPNOTSUPP;
+
+	vlan->tagged = from != 0;
+	vlan->vid = from;
+	vlan->tci = to;
+	if (from && to)
+		vlan->edit = ZX_VLAN_REPLACE;
+	else
+		vlan->edit = from ? ZX_VLAN_POP : ZX_VLAN_PUSH;
+	return 0;
+}
+
+static int zx279133_natflow_specs(struct zx279133_flow_offload *offload,
+				  const struct zte_nppt_natflow_request *req,
+				  struct zx279133_flow_spec spec[2])
+{
+	struct zte_nppt *np = offload->np;
+	u16 port[2] = {}, pppoe_sid;
+	bool vlan = req->path[0].vlan_id || req->path[1].vlan_id;
+	int d, ret, upstream;
+
+	for (d = 0; d < 2; d++) {
+		const struct zte_nppt_natflow_path *path = &req->path[d];
+		struct net_device *dev = req->dev[!d];
+		unsigned int mtu = READ_ONCE(dev->mtu);
+
+		if (!netif_running(dev) || !netif_carrier_ok(dev) ||
+		    !net_eq(dev_net(dev), &init_net) || is_vlan_dev(dev) ||
+		    mtu != ETH_DATA_LEN || path->mtu < ETH_MIN_MTU ||
+		    path->mtu > mtu ||
+		    req->eth[d].h_proto != htons(ETH_P_IP) ||
+		    !is_valid_ether_addr(req->eth[d].h_source) ||
+		    !is_valid_ether_addr(req->eth[d].h_dest))
+			return -EOPNOTSUPP;
+
+		spec[!d].ingress = zte_nppt_dev_port(np, dev, &port[!d]);
+		if (!port[!d] ||
+		    (spec[!d].ingress != ZX279133_FLOW_PORT_LAN &&
+		     !zte_nppt_is_wan(np, dev)))
+			return -EOPNOTSUPP;
+		if (path->pppoe_sid &&
+		    (vlan || path->pppoe_sid == U16_MAX ||
+		     !zte_nppt_is_wan(np, dev) || path->mtu > mtu - PPPOE_SES_HLEN))
+			return -EOPNOTSUPP;
+	}
+	if (spec[0].ingress == spec[1].ingress)
+		return -EOPNOTSUPP;
+	upstream = spec[0].ingress == ZX279133_FLOW_PORT_LAN ? 0 : 1;
+	pppoe_sid = req->path[upstream].pppoe_sid;
+
+	for (d = 0; d < 2; d++) {
+		const struct zte_nppt_natflow_tuple *in = &req->tuple[d];
+		const struct zte_nppt_natflow_tuple *reverse = &req->tuple[!d];
+
+		spec[d].egress = spec[!d].ingress;
+		spec[d].gemport = port[!d];
+		spec[d].ip_proto = in->proto;
+		spec[d].pppoe_sid = pppoe_sid;
+		spec[d].mtu = req->path[d].mtu;
+		spec[d].data.eth = req->eth[d];
+		spec[d].data.tuple = (struct zx279133_flow_tuple) {
+			.src_addr = in->src, .dst_addr = in->dst,
+			.src_port = in->sport, .dst_port = in->dport,
+		};
+		spec[d].xlate = (struct zx279133_flow_tuple) {
+			.src_addr = reverse->dst, .dst_addr = reverse->src,
+			.src_port = reverse->dport, .dst_port = reverse->sport,
+		};
+		ret = zx279133_natflow_vlan(offload, &spec[d],
+					    req->path[!d].vlan_id, req->path[d].vlan_id);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/* The request carries both directions, including the WAN encapsulation. */
+static int zx279133_natflow_install(struct zx279133_natflow_pair *pair)
+{
+	struct zx279133_flow_offload *offload = pair->offload;
+	struct zte_nppt *np = offload->np;
+	const struct zte_nppt_natflow_request *req = &pair->req;
+	struct zx279133_flow_spec spec[2] = {};
+	int d, i, first, ret;
+
+	ret = zte_nppt_begin(np);
+	if (ret)
+		return ret;
+	ret = -EOPNOTSUPP;
+	if (READ_ONCE(offload->detached) || zte_nppt_flow_ready(np))
+		goto out;
+	ret = zx279133_natflow_specs(offload, req, spec);
+	if (ret)
+		goto out;
+
+	first = spec[0].ingress == ZX279133_FLOW_PORT_LAN ? 0 : 1;
+	for (i = 0; i < 2; i++) {
+		d = first ^ i;
+		ret = zx279133_flow_install(offload, &spec[d], &pair->cookie[d]);
+		if (ret) {
+			zx279133_natflow_rollback(pair);
+			break;
+		}
+	}
+out:
+	zte_nppt_end(np);
+	return ret;
+}
+
+/* Read/remove both directions even when the first reports an error. If the
+ * supplier already retired the rules, those reads touch only cached deltas.
+ */
+static int zx279133_natflow_collect(struct zx279133_natflow_pair *pair,
+				    bool remove,
+				    struct zte_nppt_natflow_stats *stats)
+{
+	struct zx279133_flow_offload *offload = pair->offload;
+	int begin, d, ret = 0;
+
+	begin = zte_nppt_begin(offload->np);
+	for (d = 0; d < 2; d++) {
+		unsigned long cookie = pair->cookie[d];
+		struct zx279133_flow_counters sample = {};
+		struct zx279133_flow_entry *entry;
+		int err;
+
+		if (!cookie)
+			continue;
+		if (!begin) {
+			err = remove ? zx279133_flow_destroy(offload, cookie, &sample) :
+				       zx279133_flow_stats(offload, cookie, &sample);
+		} else {
+			mutex_lock(&offload->lock);
+			entry = xa_load(&offload->flows, cookie);
+			if (!entry)
+				err = -ENOENT;
+			else if (entry->retired)
+				err = zx279133_flow_entry_remove(offload, entry, cookie,
+								 &sample, false) ?: -ENOENT;
+			else
+				err = begin;
+			mutex_unlock(&offload->lock);
+		}
+		stats->bytes[d] += sample.bytes;
+		stats->packets[d] += sample.packets;
+		if (remove && (!err || err == -ENOENT))
+			pair->cookie[d] = 0;
+		else if (err)
+			ret = err;
+	}
+	if (!begin)
+		zte_nppt_end(offload->np);
+	return ret;
+}
+
+static bool zx279133_natflow_remove(struct zx279133_natflow_pair *pair, bool disconnect)
+{
+	bool retry;
+
+	pair->removing = true;
+	if (pair->cookie[0] || pair->cookie[1])
+		zx279133_natflow_collect(pair, true, &pair->final);
+	retry = pair->cookie[0] || pair->cookie[1];
+	if (pair->req.notify && (!retry || disconnect)) {
+		zx279133_natflow_notify(pair, ZTE_NPPT_NATFLOW_RELEASE, &pair->final);
+		pair->req.notify = NULL;
+	}
+	if (retry) {
+		dev_warn_ratelimited(pair->offload->dev, "retrying NPPT natflow invalidation\n");
+		return false;
+	}
+
+	list_del(&pair->list);
+	dev_put(pair->req.dev[0]);
+	dev_put(pair->req.dev[1]);
+	kref_put(&pair->offload->ref, zx279133_offload_release);
+	kfree(pair);
+	spin_lock_bh(&zx279133_natflow_queue_lock);
+	zx279133_natflow_count--;
+	spin_unlock_bh(&zx279133_natflow_queue_lock);
+	return true;
+}
+
+static void zx279133_natflow_poll(struct work_struct *work)
+{
+	struct zx279133_natflow_pair *pair, *next;
+
+	mutex_lock(&zx279133_natflow_lock);
+	spin_lock_bh(&zx279133_natflow_queue_lock);
+	list_splice_tail_init(&zx279133_natflow_pending, &zx279133_natflow_pairs);
+	spin_unlock_bh(&zx279133_natflow_queue_lock);
+
+	list_for_each_entry_safe(pair, next, &zx279133_natflow_pairs, list) {
+		struct zte_nppt_natflow_stats stats = {};
+		int ret;
+
+		if (pair->removing ||
+		    zx279133_natflow_notify(pair, ZTE_NPPT_NATFLOW_CHECK, NULL)) {
+			zx279133_natflow_remove(pair, false);
+			continue;
+		}
+		if (!pair->lastused) {
+			ret = zx279133_natflow_install(pair);
+			if (ret || zx279133_natflow_notify(pair, ZTE_NPPT_NATFLOW_READY, NULL))
+				zx279133_natflow_remove(pair, false);
+			else
+				pair->lastused = jiffies ?: 1;
+			continue;
+		}
+
+		ret = zx279133_natflow_collect(pair, false, &stats);
+		if (stats.packets[0] || stats.packets[1]) {
+			pair->lastused = jiffies ?: 1;
+			if (zx279133_natflow_notify(pair, ZTE_NPPT_NATFLOW_STATS, &stats))
+				ret = -ESTALE;
+		}
+		if (ret || time_after_eq(jiffies, pair->lastused + ZX279133_NATFLOW_IDLE))
+			zx279133_natflow_remove(pair, false);
+	}
+
+	spin_lock_bh(&zx279133_natflow_queue_lock);
+	if (zx279133_natflow_count && !zx279133_natflow_flushing)
+		queue_delayed_work(system_unbound_wq, &zx279133_natflow_work, HZ);
+	spin_unlock_bh(&zx279133_natflow_queue_lock);
+	mutex_unlock(&zx279133_natflow_lock);
+}
+
+static int zte_nppt_natflow_flush(bool disconnect)
+{
+	struct zx279133_natflow_pair *pair, *next;
+	int ret = 0;
+
+	mutex_lock(&zx279133_natflow_lock);
+	spin_lock_bh(&zx279133_natflow_queue_lock);
+	zx279133_natflow_flushing = true;
+	list_splice_tail_init(&zx279133_natflow_pending, &zx279133_natflow_pairs);
+	spin_unlock_bh(&zx279133_natflow_queue_lock);
+
+	list_for_each_entry_safe(pair, next, &zx279133_natflow_pairs, list)
+		if (!zx279133_natflow_remove(pair, disconnect))
+			ret = -EIO;
+
+	spin_lock_bh(&zx279133_natflow_queue_lock);
+	zx279133_natflow_flushing = false;
+	if (zx279133_natflow_count)
+		queue_delayed_work(system_unbound_wq, &zx279133_natflow_work, HZ);
+	spin_unlock_bh(&zx279133_natflow_queue_lock);
+	mutex_unlock(&zx279133_natflow_lock);
+	return ret;
+}
+const struct zte_nppt_natflow_api zte_nppt_natflow_api = {
+	.version = ZTE_NPPT_NATFLOW_API_VERSION,
+	.submit = zte_nppt_natflow_submit,
+	.flush = zte_nppt_natflow_flush,
+};
+EXPORT_SYMBOL_GPL(zte_nppt_natflow_api);
--- /dev/null
+++ b/drivers/net/ethernet/zte/zx279133-policy.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ZX279133_POLICY_H
+#define _ZX279133_POLICY_H
+#include <linux/types.h>
+
+/* Policy normalization independent of MMIO and Linux object lifetimes. */
+enum zx279133_vlan_edit { ZX_VLAN_KEEP, ZX_VLAN_PUSH, ZX_VLAN_POP, ZX_VLAN_REPLACE };
+
+struct zx279133_vlan_plan {
+	u16 vid;
+	u16 tci;
+	u8 edit;
+	bool tagged;
+};
+
+/* OEM fast response edit bits. Classification must be checked independently. */
+static inline void zx279133_vlan_response(u8 *fast, const struct zx279133_vlan_plan *p)
+{
+	if (!p->edit)
+		return;
+	fast[30] = (fast[30] & 0x3f) | p->edit << 6;
+	fast[24] = p->tci;
+	fast[25] = p->tci >> 8;
+	/* Native response abs(delta)/2; POP sign is carried by the edit opcode. */
+	fast[16] = p->edit == ZX_VLAN_REPLACE ? 0 : 2;
+	fast[17] = 0;
+	fast[18] = 0;
+	fast[19] = 0;
+}
+
+#endif
--- /dev/null
+++ b/include/linux/zte_nppt_natflow.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_ZTE_NPPT_NATFLOW_H
+#define _LINUX_ZTE_NPPT_NATFLOW_H
+
+#include <linux/if_ether.h>
+#include <linux/types.h>
+
+#define ZTE_NPPT_NATFLOW_API_VERSION 2
+
+struct net_device;
+
+struct zte_nppt_natflow_tuple {
+	__be32 src, dst;
+	__be16 sport, dport;
+	u8 proto;
+};
+
+enum zte_nppt_natflow_event {
+	ZTE_NPPT_NATFLOW_CHECK,
+	ZTE_NPPT_NATFLOW_READY,
+	ZTE_NPPT_NATFLOW_STATS,
+	ZTE_NPPT_NATFLOW_RELEASE,
+};
+
+struct zte_nppt_natflow_stats {
+	u64 bytes[2];
+	u64 packets[2];
+};
+
+/* Egress encapsulation of tuple[d], also seen at ingress of tuple[!d].
+ * mtu is the inner IPv4 MTU. VLAN IDs and PPPoE session IDs are in host order;
+ * zero means absent. VLAN uses a single 802.1Q tag.
+ */
+struct zte_nppt_natflow_path {
+	u16 mtu;
+	u16 vlan_id;
+	u16 pppoe_sid;
+};
+
+struct zte_nppt_natflow_request {
+	struct zte_nppt_natflow_tuple tuple[2];
+	struct net_device *dev[2];	/* Ingress of tuple[d]. */
+	struct ethhdr eth[2];		/* Egress MACs and inner EtherType. */
+	struct zte_nppt_natflow_path path[2];
+	void *context;
+	int (*notify)(void *context, enum zte_nppt_natflow_event event,
+		      const struct zte_nppt_natflow_stats *stats);
+};
+
+struct zte_nppt_natflow_api {
+	unsigned int version;
+	/* Atomic. A successful submit holds both devices and transfers context
+	 * until one RELEASE notification. Callbacks run under RCU with BH
+	 * disabled, outside NPPT hardware locks. CHECK and READY can veto a
+	 * rule pair. STATS and RELEASE carry IP-layer deltas.
+	 */
+	int (*submit)(const struct zte_nppt_natflow_request *request);
+	/* Sleepable. Quiesce submitters before draining the hardware rules.
+	 * On -EIO, entries remain quarantined and their removal is retried.
+	 * Disconnect only at client teardown, to release all its callbacks
+	 * even when the hardware could not be drained.
+	 */
+	int (*flush)(bool disconnect);
+};
+
+extern const struct zte_nppt_natflow_api zte_nppt_natflow_api;
+
+#endif
