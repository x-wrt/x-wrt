#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=99
USE_PROCD=1

start_service() {
	local enabled

	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'zte,zx279133-sr1010' ] || return 0
	[ -d /sys/class/leds/sr1010:white ] && [ -d /sys/class/leds/sr1010:red ] || return 0
	config_load sr1010-netled
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/sr1010-netled
	procd_set_param file /etc/config/sr1010-netled
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sr1010-netled
}
