Subject: [PATCH] net: pcs: mtk-usxgmii: support fixed 10G switch links

Allow explicitly configured fixed-rate USXGMII links to switches such as
YT9224. Disable in-band negotiation and use the fixed-rate adaptation mode.
Retain the link-up reset for these links while preserving the existing
no-reset behavior for PHYs using in-band USXGMII negotiation.

The opt-in mediatek,force-fixed-10g property belongs to the PCS node.
Based on the YT9224 adaptation by JiaY-shi <shi05275@163.com>.

---
--- a/drivers/net/pcs/pcs-mtk-usxgmii.c
+++ b/drivers/net/pcs/pcs-mtk-usxgmii.c
@@ -162,7 +162,12 @@
 	int ret;
 
 	if (interface == PHY_INTERFACE_MODE_USXGMII) {
-		an_ctrl = FIELD_PREP(USXGMII_AN_SYNC_CNT, 0x1FF) | USXGMII_AN_ENABLE;
+		an_ctrl = FIELD_PREP(USXGMII_AN_SYNC_CNT, 0x1FF);
+		if (of_property_read_bool(mpcs->dev->of_node,
+					  "mediatek,force-fixed-10g"))
+			adapt_mode = USXGMII_RATE_UPDATE_MODE;
+		else
+			an_ctrl |= USXGMII_AN_ENABLE;
 		link_timer = FIELD_PREP(USXGMII_LINK_TIMER_IDLE_DETECT, 0x7B) |
 			     FIELD_PREP(USXGMII_LINK_TIMER_COMP_ACK_DETECT, 0x7B) |
 			     FIELD_PREP(USXGMII_LINK_TIMER_AN_RESTART, 0x7B);
@@ -360,7 +365,9 @@
 {
 	struct mtk_usxgmii_pcs *mpcs = pcs_to_mtk_usxgmii_pcs(pcs);
 
-	if (interface == PHY_INTERFACE_MODE_USXGMII)
+	if (interface == PHY_INTERFACE_MODE_USXGMII &&
+	    !of_property_read_bool(mpcs->dev->of_node,
+				   "mediatek,force-fixed-10g"))
 		return;
 
 	/* Reconfiguring USXGMII to ensure the quality of the RX signal
